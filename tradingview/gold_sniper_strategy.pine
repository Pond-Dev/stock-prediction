//@version=6
// STRATEGY BUILD of gold_sniper.pine - identical rules, plus strategy.entry /
// strategy.exit so TradingView's Strategy Tester does the accounting. Where the
// on-chart panel and the Tester disagree, the Tester is right: it fills stops
// intrabar, the panel resolves them on the bar close. Trade this file's numbers,
// run gold_sniper.pine on the live chart.
//
// Non-repainting by construction: every decision is taken inside
// barstate.isconfirmed on closed-bar values only, and every persistent value is
// `var`, never `varip`. Realtime ticks cannot mutate state, so a reloaded chart
// replays exactly what was shown live. The price of that is the entry fill:
// the signal lands at the M1 close, not at the trigger price. Rest a stop order
// at the trigger when READY prints if you want the trigger price itself.
strategy("Gold Sniper Strategy", shorttitle="GS Strategy", overlay=true,
     max_bars_back=500, max_boxes_count=500, max_labels_count=500, max_lines_count=500,
     initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0.15,
     slippage=2, calc_on_every_tick=false, process_orders_on_close=true)
// Commission defaults to half the XAUUSDc spread per side and slippage to 2
// ticks, so a round trip costs about $0.30 on one lot. Raise both before
// believing any result; the whole point of the exercise is that this number
// decides the outcome, not the entry logic.

int strength = input.int(2, "M5 swing confirmation bars", minval=1, maxval=5, display=display.none)
float width = input.float(0.15, "Zone half-width / M5 ATR", minval=0.05, maxval=0.5, step=0.05, display=display.none)
float minRR = input.float(1.5, "Minimum reward : risk", minval=0.5, maxval=5.0, step=0.25, display=display.none)
bool withTrend = input.bool(false, "Only trade with the M5 trend", display=display.none)
int expiry = input.int(3, "Setup valid for next N M1 bars", minval=1, maxval=10, display=display.none)
int cooldown = input.int(3, "Full bars to skip after signal", minval=0, maxval=20, display=display.none)
int maxHold = input.int(30, "Give up on a trade after N minutes", minval=5, maxval=240, display=display.none)
bool simple = input.bool(false, "โหมดง่าย - โชว์เฉพาะสิ่งที่ต้องทำ", display=display.none)
bool showZones = input.bool(true, "โชว์โซน", display=display.none)
bool useOB = input.bool(true, "Add M1 internal Order Block zones (SMC)", display=display.none)
bool useSession = input.bool(true, "Only arm new setups during session", display=display.none)
string sessionHours = input.session("0800-1130,1330-1700", "Session hours (exchange tz below)", display=display.none)
string sessionTz = input.string("America/New_York", "Session timezone", display=display.none)
string mode = input.string("Loose", "Aggressiveness", options=["Strict", "Normal", "Loose", "YOLO"], display=display.none)

// Aggressiveness dial. Strict reproduces the frozen gates the MT5 shadow runs.
// Every step up buys signal count with entry quality. None of it moves the stop,
// the zone map, or position size - only how fussy the entry filter is.
int lvl = mode == "Strict" ? 0 : mode == "Normal" ? 1 : mode == "Loose" ? 2 : 3
float cpEdge = lvl == 0 ? 0.65 : lvl == 1 ? 0.58 : lvl == 2 ? 0.52 : 0.50
float chaseCap = lvl == 0 ? 0.15 : lvl == 1 ? 0.35 : lvl == 2 ? 0.75 : 1.50
float minSpan = lvl == 0 ? 0.25 : lvl == 1 ? 0.20 : lvl == 2 ? 0.15 : 0.10
float resetAtr = lvl == 0 ? 0.25 : lvl == 1 ? 0.20 : lvl == 2 ? 0.15 : 0.10
float nearCap = lvl == 0 ? 1.00 : lvl == 1 ? 1.25 : lvl == 2 ? 1.75 : 2.50
float rrFloor = lvl == 0 ? minRR : lvl == 1 ? math.min(minRR, 1.25) : lvl == 2 ? math.min(minRR, 1.00) : 0.0
int validFor = lvl == 0 ? expiry : lvl == 1 ? expiry + 2 : lvl == 2 ? expiry + 4 : expiry + 7
int coolFor = lvl == 0 ? cooldown : lvl == 1 ? math.max(cooldown - 1, 1) : lvl == 2 ? 1 : 0
bool clearFull = lvl <= 1

if barstate.isfirst and (not timeframe.isminutes or timeframe.multiplier != 1 or not chart.is_standard)
    runtime.error("Use standard 1-minute candles.")

// --- series that must be evaluated on every bar, never inside a branch ---
float a = ta.atr(14)[1]
float tick = syminfo.mintick
float pad = math.max(2 * tick, a * 0.05)
bool inSession = not useSession or not na(time(timeframe.period, sessionHours, sessionTz))
[pl, ph, ma, mt, m5Close, m5Fast, m5Slow] = request.security(syminfo.tickerid, "5", [ta.pivotlow(low, strength, strength)[1], ta.pivothigh(high, strength, strength)[1], ta.atr(14)[1], time[1], close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1]], lookahead=barmerge.lookahead_on)
float fast = ta.ema(close, 20)
float slow = ta.ema(close, 50)
bool trendUp = fast > slow and fast > fast[3] and slow >= slow[3] and fast - slow >= a * 0.10 and m5Close > m5Fast and m5Fast > m5Slow
bool trendDown = fast < slow and fast < fast[3] and slow <= slow[3] and slow - fast >= a * 0.10 and m5Close < m5Fast and m5Fast < m5Slow
float atr200 = ta.atr(200)
bool volatile = high - low >= 2 * atr200
float pHigh = volatile ? low : high
float pLow = volatile ? high : low
int lowOff = -ta.lowestbars(pLow, 6)
int highOff = -ta.highestbars(pHigh, 6)
bool newLegHigh = high[5] > ta.highest(high, 5)
bool newLegLow = low[5] < ta.lowest(low, 5)

color green = #00E676
color red = #FF1744
color amber = #FFAB00
color blue = #2979FF
color panelBg = #131722
color invisible = color.new(color.white, 100)

// --- persistent state: var only, mutated only on confirmed bars ---
var array<float> bottoms = array.new_float()
var array<float> tops = array.new_float()
var array<int> sides = array.new_int()
var array<int> kinds = array.new_int()
var array<int> births = array.new_int()
var array<bool> available = array.new_bool()
var array<int> touches = array.new_int()
var array<bool> touching = array.new_bool()
var int lastM5 = na
var int structure = 0
var int leg = 0
var float swingHi = na
var float swingLo = na
var bool hiCrossed = true
var bool loCrossed = true
var float obLow = na
var float obLowTop = na
var float obHigh = na
var float obHighBottom = na
var int pending = 0
var int armed = na
var int zoneBirth = na
var float entry = na
var float invalid = na
var float target = na
var float setupAtr = na
var int lastSignal = na
var int tradesToday = 0
var string status = "Waiting for price to reach a good level"
var int tSide = 0
var float tEntry = na
var float tSL = na
var float tTP = na
var int tBar = na
var box dTradeRisk = na
var box dTradeReward = na
var line dTradeEntry = na
var int noSize = 0
var int noRej = 0
var int noFresh = 0
var int noNear = 0
var int noRR = 0
var int noTrend = 0
var int noCool = 0

f_remove(int i) =>
    array.remove(bottoms, i)
    array.remove(tops, i)
    array.remove(sides, i)
    array.remove(kinds, i)
    array.remove(births, i)
    array.remove(available, i)
    array.remove(touches, i)
    array.remove(touching, i)

f_breakLean(int side, int n) =>
    int score = (structure == -side ? 1 : 0) + ((side == 1 ? fast < slow : fast > slow) ? 1 : 0) + (n >= 3 ? 1 : 0)
    score >= 2

f_addZone(float lo, float hi, int side, int kind) =>
    bool overlap = false
    if array.size(sides) > 0
        for i = 0 to array.size(sides) - 1
            if array.get(sides, i) == side and lo <= array.get(tops, i) and hi >= array.get(bottoms, i)
                overlap := true
    if not overlap and not na(lo) and not na(hi)
        array.push(bottoms, lo)
        array.push(tops, hi)
        array.push(sides, side)
        array.push(kinds, kind)
        array.push(births, time)
        array.push(available, true)
        array.push(touches, 0)
        array.push(touching, false)
        if array.size(sides) > 12
            f_remove(0)

f_add(float price, int side) =>
    float halfWidth = math.max(2 * tick, ma * width)
    f_addZone(price - halfWidth, price + halfWidth, side, 0)

f_room(int side, float price) =>
    float room = na
    if array.size(sides) > 0
        for i = 0 to array.size(sides) - 1
            float lo = array.get(bottoms, i)
            float hi = array.get(tops, i)
            if array.get(sides, i) == -side and (side == 1 ? hi >= price : lo <= price)
                float distance = math.max(0, side == 1 ? lo - price : price - hi)
                room := na(room) ? distance : math.min(room, distance)
    room

f_gates(int j) =>
    int side = array.get(sides, j)
    float lo = array.get(bottoms, j)
    float hi = array.get(tops, j)
    float span = high - low
    float cp = span > 0 ? (close - low) / span : 0.5
    bool touch = low <= hi and high >= lo
    // Loose modes accept a close past the zone midpoint instead of clearing the
    // far edge. That is the single biggest reason a valid bounce got thrown away.
    float mid = (lo + hi) / 2
    bool rejection = side == 1 ? close[1] > lo and touch and close > (clearFull ? hi : mid) and close > open and cp >= cpEdge : close[1] < hi and touch and close < (clearFull ? lo : mid) and close < open and cp <= 1 - cpEdge
    float trigger = side == 1 ? math.ceil((high + pad) / tick) * tick : math.floor((low - pad) / tick) * tick
    float stretch = side == 1 ? trigger - hi : lo - trigger
    float room = f_room(side, trigger)
    float stopDist = side == 1 ? trigger - (math.min(low, lo) - pad) : (math.max(high, hi) + pad) - trigger
    float rr = room / stopDist
    bool sizeOK = span >= a * minSpan
    bool fresh = array.get(available, j)
    bool nearOK = stretch <= a * nearCap
    bool rrOK = na(room) or room >= stopDist * rrFloor
    bool trendOK = not withTrend or not (side == 1 ? trendDown : trendUp)
    [touch, rejection, sizeOK, fresh, nearOK, rrOK, trendOK, stretch, rr]

// Per-bar signals. Plain series, so they reset on every recalculation and can
// never survive a tick rollback the way the old varip flags did.
int signalSide = 0
int readySide = 0
int exitKind = 0
float exitPrice = na

if barstate.isconfirmed
    if dayofmonth != dayofmonth[1]
        tradesToday := 0

    // A. Manage the open trade first. A bar that touches both stop and target
    // is reported as a stop-out: M1 OHLC cannot say which came first, and
    // guessing the good one is exactly how a forward test flatters itself.
    if tSide != 0
        bool hitSL = tSide == 1 ? low <= tSL : high >= tSL
        bool hitTP = tSide == 1 ? high >= tTP : low <= tTP
        if hitSL
            exitKind := -1
            exitPrice := tSL
        else if hitTP
            exitKind := 1
            exitPrice := tTP
        else if bar_index - tBar >= maxHold or not inSession
            exitKind := 2
            exitPrice := close
        box.set_right(dTradeRisk, bar_index)
        box.set_right(dTradeReward, bar_index)
        line.set_x2(dTradeEntry, bar_index)
        if exitKind != 0
            if exitKind == 2
                strategy.close_all(comment="หมดเวลา")
            tSide := 0
            alert("Gold Sniper · " + syminfo.tickerid + " · ปิดไม้ " + (exitKind == 1 ? "ถึงเป้า" : exitKind == -1 ? "โดนกัน" : "หมดเวลา/หมด session") + " ที่ " + str.tostring(exitPrice, format.mintick), alert.freq_once_per_bar_close)

    // B. Resolve an armed setup on the closed bar, same test the MQ5 EA uses.
    if pending != 0 and bar_index > armed
        bool exists = false
        if array.size(sides) > 0
            for i = 0 to array.size(sides) - 1
                if array.get(births, i) == zoneBirth and array.get(sides, i) == pending
                    exists := true
        bool invalidHit = pending == 1 ? low <= invalid : high >= invalid
        bool gap = time - time[1] > 60000
        float room = f_room(pending, close)
        float triggerRoom = f_room(pending, entry)
        float stopDist = math.abs(entry - invalid)
        bool roomOK = (na(room) or room >= stopDist * rrFloor) and (na(triggerRoom) or triggerRoom >= stopDist * rrFloor)
        bool through = pending == 1 ? close >= entry : close <= entry
        float overshoot = pending == 1 ? close - entry : entry - close
        if not exists or invalidHit or gap or bar_index - armed > validFor or time - zoneBirth >= 28800000
            status := "Cancelled - price never came back"
            pending := 0
        else if through
            if overshoot <= setupAtr * chaseCap and roomOK and tSide == 0
                signalSide := pending
                tradesToday += 1
                lastSignal := bar_index
                tSide := pending
                tEntry := close
                tSL := invalid
                tTP := target
                tBar := bar_index
                dTradeRisk := box.new(bar_index, math.max(close, invalid), bar_index, math.min(close, invalid), xloc=xloc.bar_index, border_color=invisible, bgcolor=color.new(red, 85))
                dTradeReward := box.new(bar_index, math.max(close, target), bar_index, math.min(close, target), xloc=xloc.bar_index, border_color=invisible, bgcolor=color.new(green, 85))
                dTradeEntry := line.new(bar_index, close, bar_index, close, xloc=xloc.bar_index, color=color.white, width=1)
                strategy.entry(pending == 1 ? "ซื้อ" : "ขาย", pending == 1 ? strategy.long : strategy.short)
                strategy.exit(pending == 1 ? "ซื้อ" : "ขาย", from_entry=pending == 1 ? "ซื้อ" : "ขาย", stop=invalid, limit=target)
                status := pending == 1 ? "GO! Buy now" : "GO! Sell now"
                alert("Gold Sniper · " + syminfo.tickerid + " · M1 · " + mode + " · " + (pending == 1 ? "ซื้อ" : "ขาย") + " · ได้ที่ " + str.tostring(close, format.mintick) + " · จุดตั้ง " + str.tostring(entry, format.mintick) + " · กัน " + str.tostring(invalid, format.mintick) + " · เป้า " + str.tostring(target, format.mintick) + (pending * structure < 0 ? " · สวนโครงสร้าง" : ""), alert.freq_once_per_bar_close)
            else
                status := tSide != 0 ? "Skipped - already in a trade" : roomOK ? "Skipped - price jumped too far past the trigger" : "Skipped - reward too small for the risk"
            pending := 0

    // C. M1 internal structure and order-block zones.
    int legPrev = leg
    if newLegHigh
        leg := 0
    else if newLegLow
        leg := 1
    if leg == 0 and legPrev == 1
        swingHi := high[5]
        hiCrossed := false
        obLow := pLow[lowOff]
        obLowTop := pHigh[lowOff]
    if leg == 1 and legPrev == 0
        swingLo := low[5]
        loCrossed := false
        obHigh := pHigh[highOff]
        obHighBottom := pLow[highOff]
    if not hiCrossed and close > swingHi
        hiCrossed := true
        structure := 1
        if useOB and obLowTop - obLow > 0 and obLowTop - obLow <= a * 1.5
            f_addZone(obLow, obLowTop, 1, 1)
    if not loCrossed and close < swingLo
        loCrossed := true
        structure := -1
        if useOB and obHigh - obHighBottom > 0 and obHigh - obHighBottom <= a * 1.5
            f_addZone(obHighBottom, obHigh, -1, 1)
    if pLow < obLow
        obLow := pLow
        obLowTop := pHigh
    if pHigh > obHigh
        obHigh := pHigh
        obHighBottom := pLow

    // D. M5 pivot zones, one shot per completed M5 bar.
    if not na(mt) and (na(lastM5) or mt != lastM5)
        lastM5 := mt
        if not na(pl)
            f_add(pl, 1)
        if not na(ph)
            f_add(ph, -1)

    // E. Zone bookkeeping.
    int i = array.size(sides) - 1
    while i >= 0
        int side = array.get(sides, i)
        float lo = array.get(bottoms, i)
        float hi = array.get(tops, i)
        bool inside = low <= hi and high >= lo
        if inside and not array.get(touching, i)
            array.set(touches, i, array.get(touches, i) + 1)
        array.set(touching, i, inside)
        if (side == 1 ? close < lo : close > hi) or time - array.get(births, i) >= 28800000
            f_remove(i)
        else if side == 1 ? low > hi + a * resetAtr : high < lo - a * resetAtr
            array.set(available, i, true)
        i -= 1
    bool stillExists = false
    if pending != 0 and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            if array.get(births, j) == zoneBirth and array.get(sides, j) == pending
                stillExists := true
    if pending != 0 and not stillExists
        pending := 0
        status := "Cancelled - the level broke"

    // F. Arm a new setup.
    float span = high - low
    bool eligible = pending == 0 and tSide == 0 and signalSide == 0 and not na(a) and a > 0 and span >= a * minSpan and (na(lastSignal) or bar_index - lastSignal > coolFor) and inSession
    int chosen = -1
    float best = na
    bool conflict = false
    if eligible and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            int side = array.get(sides, j)
            [touch, rejection, sizeOK, fresh, nearOK, rrOK, trendOK, stretch, rr] = f_gates(j)
            if rejection and trendOK and fresh and nearOK and rrOK
                if chosen >= 0 and array.get(sides, chosen) != side
                    conflict := true
                if na(best) or stretch < best
                    best := stretch
                    chosen := j
    if chosen >= 0 and not conflict
        pending := array.get(sides, chosen)
        zoneBirth := array.get(births, chosen)
        entry := pending == 1 ? math.ceil((high + pad) / tick) * tick : math.floor((low - pad) / tick) * tick
        invalid := pending == 1 ? math.min(low, array.get(bottoms, chosen)) - pad : math.max(high, array.get(tops, chosen)) + pad
        float room = f_room(pending, entry)
        float risk = math.abs(entry - invalid)
        // Never show a target below 1R, even when rrFloor is relaxed to 0.
        target := entry + pending * math.max(na(room) ? risk * math.max(rrFloor, 1.0) : room, risk)
        setupAtr := a
        armed := bar_index
        readySide := pending
        status := pending == 1 ? "Get ready to BUY" : "Get ready to SELL"
    else if pending == 0 and tSide == 0 and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            if low <= array.get(tops, j) and high >= array.get(bottoms, j)
                status := (array.get(sides, j) == 1 ? "In the BUY zone" : "In the SELL zone") + " - waiting for a rejection candle" + (eligible ? "" : not inSession ? " (outside session)" : span < a * minSpan ? " (candle too small)" : " (cooldown)")

    // G. Gate funnel. For every touched zone, count the FIRST gate that blocked
    // it, so the panel says which condition to loosen instead of us guessing.
    if pending == 0 and chosen < 0 and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            [gTouch, gRej, gSize, gFresh, gNear, gRR, gTrend, gStretch, gRr] = f_gates(j)
            if gTouch
                bool gCool = na(lastSignal) or bar_index - lastSignal > coolFor
                if not gSize
                    noSize += 1
                else if not gRej
                    noRej += 1
                else if not gFresh
                    noFresh += 1
                else if not gNear
                    noNear += 1
                else if not gRR
                    noRR += 1
                else if not gTrend
                    noTrend += 1
                else if not gCool
                    noCool += 1

// ---------------------------------------------------------------------------
// Everything below is pixels only. Nothing here writes decision state, and the
// `d` prefix marks that for the source check. On-chart text is Thai by owner
// directive; code and comments stay English.
// ---------------------------------------------------------------------------
var array<box> dBoxes = array.new_box()
var line dEntryLine = na
var line dStopLine = na
var line dTargetLine = na
var box dRiskBox = na
var box dRewardBox = na
var label dTicket = na

// Tint the bars where a setup is live. Cheapest possible "something is
// happening" cue, and it is bar state so it survives a reload unchanged.
bgcolor(pending == 1 ? color.new(green, 93) : pending == -1 ? color.new(red, 93) : tSide != 0 ? color.new(blue, 95) : na, title="Setup tint")

if barstate.islast
    for b in dBoxes
        box.delete(b)
    array.clear(dBoxes)
    if showZones and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            float lo = array.get(bottoms, j)
            float hi = array.get(tops, j)
            // Simple mode keeps only the zones price could actually reach today.
            if not simple or math.abs(close - (lo + hi) / 2) <= a * 4
                int side = array.get(sides, j)
                bool brk = f_breakLean(side, array.get(touches, j))
                color c = side == 1 ? green : red
                bool ob = array.get(kinds, j) == 1
                box b = box.new(left=array.get(births, j), top=hi, right=time + 60000, bottom=lo, xloc=xloc.bar_time, border_color=brk ? amber : c, border_width=brk ? 1 : 2, border_style=ob ? line.style_dashed : line.style_solid, bgcolor=color.new(brk ? amber : c, brk ? 92 : 85))
                array.push(dBoxes, b)

    line.delete(dEntryLine)
    line.delete(dStopLine)
    line.delete(dTargetLine)
    box.delete(dRiskBox)
    box.delete(dRewardBox)
    label.delete(dTicket)

    int tSideNow = tSide != 0 ? tSide : pending
    float pxIn = tSide != 0 ? tEntry : entry
    float pxSL = tSide != 0 ? tSL : invalid
    float pxTP = tSide != 0 ? tTP : target
    int x0 = tSide != 0 ? tBar : armed
    int x1 = bar_index + 10

    string ticket = ""
    color ticketColor = color.new(color.gray, 30)
    if tSideNow != 0 and not na(pxIn)
        // Dashed guide lines out to the right edge so the three prices are
        // readable ahead of price. A filled trade already owns its own shaded
        // boxes from the fill bar, so only an unfilled setup needs them here.
        if tSide == 0
            dRiskBox := box.new(x0, math.max(pxIn, pxSL), x1, math.min(pxIn, pxSL), xloc=xloc.bar_index, border_color=color.new(red, 60), bgcolor=color.new(red, 88))
            dRewardBox := box.new(x0, math.max(pxIn, pxTP), x1, math.min(pxIn, pxTP), xloc=xloc.bar_index, border_color=color.new(green, 60), bgcolor=color.new(green, 88))
        dEntryLine := line.new(x0, pxIn, x1, pxIn, xloc=xloc.bar_index, color=color.white, width=2)
        dStopLine := line.new(x0, pxSL, x1, pxSL, xloc=xloc.bar_index, color=red, width=2, style=line.style_dashed)
        dTargetLine := line.new(x0, pxTP, x1, pxTP, xloc=xloc.bar_index, color=color.aqua, width=2, style=line.style_dashed)

        float risk = math.abs(pxIn - pxSL)
        float reward = math.abs(pxTP - pxIn)
        string arrow = tSideNow == 1 ? "▲" : "▼"
        if tSide != 0
            float rNow = tSide * (close - tEntry) / risk
            int left = maxHold - (bar_index - tBar)
            ticket := arrow + " ถืออยู่ " + (tSide == 1 ? "ซื้อ" : "ขาย") + "\n" +
                 "ตอนนี้   " + str.tostring(rNow, "+0.00;-0.00") + " R\n" +
                 "เข้าที่   " + str.tostring(pxIn, format.mintick) + "\n" +
                 "กันที่   " + str.tostring(pxSL, format.mintick) + "\n" +
                 "เป้าที่  " + str.tostring(pxTP, format.mintick) + "\n" +
                 "เหลือ   " + str.tostring(left) + " นาที"
            ticketColor := color.new(rNow >= 0 ? green : red, 15)
        else
            ticket := arrow + " วาง " + (tSideNow == 1 ? "BUY STOP" : "SELL STOP") + "\n" +
                 "เข้าที่   " + str.tostring(pxIn, format.mintick) + "\n" +
                 "กันที่   " + str.tostring(pxSL, format.mintick) + "   (" + str.tostring(-risk, "#.##") + ")\n" +
                 "เป้าที่  " + str.tostring(pxTP, format.mintick) + "   (+" + str.tostring(reward, "#.##") + ")\n" +
                 "ได้:เสีย 1 : " + str.tostring(reward / risk, "#.#") + "\n" +
                 "เหลือ   " + str.tostring(validFor - (bar_index - armed)) + " นาที"
            ticketColor := color.new(tSideNow == 1 ? green : red, 15)
    else
        string near = "ยังไม่มีโซนใกล้"
        if array.size(sides) > 0
            int k = -1
            float d = na
            for j = 0 to array.size(sides) - 1
                float lo = array.get(bottoms, j)
                float hi = array.get(tops, j)
                float dist = close > hi ? close - hi : close < lo ? lo - close : 0
                if na(d) or dist < d
                    k := j
                    d := dist
            near := (array.get(sides, k) == 1 ? "โซนซื้อ " : "โซนขาย ") + str.tostring(array.get(bottoms, k), format.mintick) + " - " + str.tostring(array.get(tops, k), format.mintick) + "\n" + (d == 0 ? "ราคาอยู่ในโซนแล้ว" : "ห่าง " + str.tostring(d / a, "#.#") + " แท่ง")
        ticket := "รอ - ยังไม่ต้องทำอะไร\n" + near

    dTicket := label.new(bar_index + 12, close, ticket, xloc=xloc.bar_index, yloc=yloc.price, color=ticketColor, textcolor=color.white, style=label.style_label_left, size=size.normal, textalign=text.align_left, text_font_family=font.family_monospace)

plot(simple ? na : fast, "EMA 20", color=#FFB300, linewidth=2, display=display.pane)
plot(simple ? na : slow, "EMA 50", color=blue, linewidth=2, display=display.pane)
plot(pending != 0 ? entry : tSide != 0 ? tEntry : na, "ราคาเข้า", color=color.white, linewidth=1, style=plot.style_linebr, display=display.price_scale)
plot(pending != 0 ? invalid : tSide != 0 ? tSL : na, "จุดกัน", color=red, linewidth=1, style=plot.style_linebr, display=display.price_scale)
plot(pending != 0 ? target : tSide != 0 ? tTP : na, "เป้า", color=color.aqua, linewidth=1, style=plot.style_linebr, display=display.price_scale)
plotshape(readySide == 1, "เตรียมซื้อ", shape.triangleup, location.belowbar, green, size=size.small, display=display.pane)
plotshape(readySide == -1, "เตรียมขาย", shape.triangledown, location.abovebar, red, size=size.small, display=display.pane)
plotshape(signalSide == 1, "เข้าซื้อ", shape.labelup, location.belowbar, green, text="ซื้อ", textcolor=color.white, display=display.pane)
plotshape(signalSide == -1, "เข้าขาย", shape.labeldown, location.abovebar, red, text="ขาย", textcolor=color.white, display=display.pane)
plotshape(exitKind == 1, "ถึงเป้า", shape.xcross, location.abovebar, color.aqua, size=size.tiny, display=display.pane)
plotshape(exitKind == -1, "โดนกัน", shape.xcross, location.belowbar, red, size=size.tiny, display=display.pane)
plotshape(exitKind == 2, "หมดเวลา", shape.xcross, location.abovebar, amber, size=size.tiny, display=display.pane)

f_plan(int j, bool isSupport) =>
    string act = isSupport ? "ซื้อ" : "ขาย"
    string msg = "ไม่มีระดับ" + act + "ใกล้ ๆ"
    bool brk = true
    if j >= 0
        float edge = isSupport ? array.get(tops, j) : array.get(bottoms, j)
        float away = (isSupport ? close - edge : edge - close) / a
        brk := f_breakLean(isSupport ? 1 : -1, array.get(touches, j))
        msg := brk ? "อย่า" + act + "ตรงนี้ ระดับนี้อ่อน" : "ระดับ" + act + " " + str.tostring(edge, format.mintick) + "  (ห่าง " + str.tostring(away, "#.#") + " แท่ง)"
    [msg, brk]

f_headline() =>
    string t = tSide != 0 ? (tSide == 1 ? "ถือซื้ออยู่จาก " : "ถือขายอยู่จาก ") + str.tostring(tEntry, format.mintick) + "   กัน " + str.tostring(tSL, format.mintick) + "   เป้า " + str.tostring(tTP, format.mintick) + "   เหลือ " + str.tostring(maxHold - (bar_index - tBar)) + " นาที" : pending == 0 ? "รอ - ยังไม่ต้องเข้า" : (pending == 1 ? "วาง BUY STOP ที่ " : "วาง SELL STOP ที่ ") + str.tostring(entry, format.mintick) + "   กัน " + str.tostring(invalid, format.mintick) + "   เป้า " + str.tostring(target, format.mintick) + "  (ได้:เสีย 1:" + str.tostring(math.abs(target - entry) / math.abs(entry - invalid), "#.#") + ")"
    t

var table dPanel = table.new(position.bottom_right, 1, 15, bgcolor=panelBg, frame_color=color.new(color.white, 60), frame_width=1, border_color=color.new(color.white, 88), border_width=1)
f_row(int r, bool ok, string txt) =>
    table.cell(dPanel, 0, r, (ok ? "✓  " : "✗  ") + txt, text_color=ok ? green : red, text_halign=text.align_left, text_size=size.small)

if barstate.islast
    color pendingColor = tSide != 0 ? (tSide == 1 ? green : red) : pending == 1 ? green : pending == -1 ? red : color.white
    table.cell(dPanel, 0, 0, "GOLD SNIPER  ·  " + mode + "  ·  วันนี้ " + str.tostring(tradesToday) + " ไม้", text_color=color.white, bgcolor=color.new(color.white, 85), text_size=size.small)
    table.cell(dPanel, 0, 1, f_headline(), text_color=pendingColor, bgcolor=pending == 0 and tSide == 0 ? panelBg : color.new(pendingColor, 80), text_size=size.normal)
    table.cell(dPanel, 0, 2, status, text_color=color.white, text_size=size.small)
    if simple
        table.clear(dPanel, 0, 3, 0, 14)
    else
        bool against = (pending != 0 ? pending : tSide) * structure < 0
        int sIdx = -1
        int rIdx = -1
        float sTop = na
        float rBot = na
        if array.size(sides) > 0
            for j = 0 to array.size(sides) - 1
                float tp = array.get(tops, j)
                float bt = array.get(bottoms, j)
                if array.get(sides, j) == 1 and tp <= close and (na(sTop) or tp > sTop)
                    sIdx := j
                    sTop := tp
                if array.get(sides, j) == -1 and bt >= close and (na(rBot) or bt < rBot)
                    rIdx := j
                    rBot := bt
        [belowText, belowBrk] = f_plan(sIdx, true)
        [aboveText, aboveBrk] = f_plan(rIdx, false)
        string regime = trendUp ? "ราคากำลังขึ้น เอียงไปทางซื้อ" : trendDown ? "ราคากำลังลง เอียงไปทางขาย" : "ราคาออกข้าง ซื้อขายได้ทั้งคู่"
        color regimeColor = trendUp ? green : trendDown ? red : blue
        table.cell(dPanel, 0, 3, regime + (against ? "   ระวัง: ไม้นี้สวนโครงสร้าง" : ""), text_color=against ? amber : regimeColor, bgcolor=color.new(against ? amber : regimeColor, 85), text_size=size.small)
        table.cell(dPanel, 0, 4, belowText, text_color=belowBrk ? amber : green, text_size=size.small)
        table.cell(dPanel, 0, 5, aboveText, text_color=aboveBrk ? amber : red, text_size=size.small)
        int fIdx = -1
        float fDist = na
        if array.size(sides) > 0
            for j = 0 to array.size(sides) - 1
                float lo = array.get(bottoms, j)
                float hi = array.get(tops, j)
                float d = close > hi ? close - hi : close < lo ? lo - close : 0
                if na(fDist) or d < fDist
                    fIdx := j
                    fDist := d
        string head = pending != 0 ? "ตั้งไว้แล้ว - เหลือ " + str.tostring(validFor - (bar_index - armed)) + " แท่ง ให้ทะลุ " + str.tostring(entry, format.mintick) : fIdx < 0 ? "เช็คลิสต์ - ยังไม่มีโซนบนกราฟ" : "เช็คลิสต์ - โซนใกล้สุด " + (array.get(sides, fIdx) == 1 ? "ซื้อ " : "ขาย ") + str.tostring(array.get(bottoms, fIdx), format.mintick) + " - " + str.tostring(array.get(tops, fIdx), format.mintick) + (fDist == 0 ? "  (ราคาอยู่ในโซน)" : "  (ห่าง " + str.tostring(fDist / a, "#.#") + " แท่ง)")
        string funnel = "ที่ถูกปัดไปแล้ว - แท่งเล็ก " + str.tostring(noSize) + " | ไม่เด้ง " + str.tostring(noRej) + " | ใช้ไปแล้ว " + str.tostring(noFresh) + " | ไกลไป " + str.tostring(noNear) + " | ได้:เสีย " + str.tostring(noRR) + " | เทรนด์ " + str.tostring(noTrend) + " | คูลดาวน์ " + str.tostring(noCool)
        table.cell(dPanel, 0, 6, head + "\n" + funnel, text_color=color.white, bgcolor=color.new(color.white, 85), text_size=size.small)
        if pending == 0 and tSide == 0 and fIdx >= 0
            int side = array.get(sides, fIdx)
            [touch, rejection, sizeOK, fresh, nearOK, rrOK, trendOK, stretch, rr] = f_gates(fIdx)
            bool coolOK = na(lastSignal) or bar_index - lastSignal > coolFor
            f_row(7, touch, "ราคาแตะโซนแล้ว")
            f_row(8, rejection, side == 1 ? "แท่งเด้ง: เขียว ปิดเหนือ " + str.tostring(clearFull ? array.get(tops, fIdx) : (array.get(bottoms, fIdx) + array.get(tops, fIdx)) / 2, format.mintick) + " ปิดในโซนบน " + str.tostring((1 - cpEdge) * 100, "#") + "%" : "แท่งเด้ง: แดง ปิดใต้ " + str.tostring(clearFull ? array.get(bottoms, fIdx) : (array.get(bottoms, fIdx) + array.get(tops, fIdx)) / 2, format.mintick) + " ปิดในโซนล่าง " + str.tostring((1 - cpEdge) * 100, "#") + "%")
            f_row(9, sizeOK, "ไม่ใช่โดจิ (แท่ง >= " + str.tostring(minSpan, "#.##") + " ATR)")
            f_row(10, fresh, "โซนนี้ยังไม่ถูกใช้")
            f_row(11, nearOK, "จุดเข้าห่างโซนไม่เกิน " + str.tostring(nearCap, "#.##") + " ATR (" + str.tostring(stretch / a, "#.##") + ")")
            f_row(12, rrOK, na(rr) ? "ได้:เสีย เปิดโล่ง ไม่มีโซนขวาง" : "ได้:เสีย 1:" + str.tostring(rr, "#.#") + "  (ต้องการ " + str.tostring(rrFloor, "#.##") + ")")
            f_row(13, trendOK, withTrend ? "เทรนด์ M5 ยอมให้" + (side == 1 ? "ซื้อ" : "ขาย") : "ตัวกรองเทรนด์ปิดอยู่")
            f_row(14, coolOK, "พ้นคูลดาวน์แล้ว (" + str.tostring(coolFor) + " แท่ง)")
        else
            table.clear(dPanel, 0, 7, 0, 14)
