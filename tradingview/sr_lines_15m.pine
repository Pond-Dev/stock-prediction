//@version=6
indicator("แนวรับแนวต้าน 15m", overlay = true, max_lines_count = 50)

tfIn     = input.timeframe("15", "TF ที่ใช้หาเส้น", tooltip = "เว้นว่าง = ใช้ TF ของกราฟ")
nSide    = input.int(2, "จำนวนเส้นต่อฝั่ง", minval = 1, maxval = 3)
resCol   = input.color(color.red, "สีแนวต้าน")
supCol   = input.color(color.blue, "สีแนวรับ")
lineW    = input.int(1, "ความหนาเส้น", minval = 1, maxval = 4)

grpFind  = "หาเส้น"
minTips  = input.int(3, "ปลายไส้ขั้นต่ำที่ราคาเดียวกัน", minval = 2, group = grpFind)
tolK     = input.float(0.25, "ราคาเดียวกัน = ห่างกันไม่เกิน (× ATR)", minval = 0.05, step = 0.05, group = grpFind)
pivLen   = input.int(2, "ปลายไส้ต้องสูง/ต่ำกว่าแท่งข้าง ๆ (แท่ง)", minval = 1, group = grpFind)
lookback = input.int(200, "ย้อนหลัง (แท่ง)", minval = 20, maxval = 1000, group = grpFind)
minSep   = input.float(1.0, "เส้นฝั่งเดียวกันห่างกันอย่างน้อย (× ATR)", minval = 0, step = 0.25, group = grpFind)

pickSpaced(array<float> src, float gap) =>
    array<float> out = array.new<float>()
    for p in src
        bool ok = true
        for q in out
            if math.abs(p - q) < gap
                ok := false
                break
        if ok and out.size() < 3
            out.push(p)
    out

calcLevels() =>
    var tipP = array.new<float>()
    var tipB = array.new<int>()
    var outs = array.new<float>(6, na)
    array<float> snap = outs.copy()

    float ph = ta.pivothigh(high, pivLen, pivLen)
    float pl = ta.pivotlow(low, pivLen, pivLen)
    float atr = ta.atr(14)
    if not na(ph)
        tipP.push(ph)
        tipB.push(bar_index - pivLen)
    if not na(pl)
        tipP.push(pl)
        tipB.push(bar_index - pivLen)
    bool trimming = true
    while trimming
        if tipB.size() > 0
            if tipB.first() < bar_index - lookback
                tipB.shift()
                tipP.shift()
            else
                trimming := false
        else
            trimming := false

    array<float> ups = array.new<float>()
    array<float> dns = array.new<float>()
    int n = tipP.size()
    if n >= minTips and not na(atr)
        float band = 2 * tolK * atr
        array<float> s = tipP.copy()
        s.sort(order.ascending)
        int j = 0
        while j < n
            int k = j
            bool grow = true
            while grow
                if k + 1 < n
                    if s.get(k + 1) <= s.get(j) + band
                        k += 1
                    else
                        grow := false
                else
                    grow := false
            if k - j + 1 >= minTips
                float lo = s.get(j)
                float hi = s.get(k)
                if hi > close
                    ups.push(hi)
                if lo < close
                    dns.push(lo)
                j := k + 1
            else
                j += 1
    ups.sort(order.ascending)
    dns.sort(order.descending)
    float gap = na(atr) ? 0.0 : minSep * atr
    array<float> pu = pickSpaced(ups, gap)
    array<float> pd = pickSpaced(dns, gap)
    for i = 0 to 2
        if i < pu.size()
            outs.set(i, pu.get(i))
        else
            outs.set(i, na)
        if i < pd.size()
            outs.set(i + 3, pd.get(i))
        else
            outs.set(i + 3, na)
    [snap.get(0), snap.get(1), snap.get(2), snap.get(3), snap.get(4), snap.get(5)]

[r1, r2, r3, s1, s2, s3] = request.security(syminfo.tickerid, tfIn, calcLevels(), lookahead = barmerge.lookahead_on)

var array<line> drawn = array.new<line>()
if barstate.islast
    for ln in drawn
        ln.delete()
    drawn.clear()
    array<float> lv = array.from(r1, r2, r3, s1, s2, s3)
    for k = 0 to 5
        float p = lv.get(k)
        if not na(p) and k % 3 < nSide
            drawn.push(line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = k < 3 ? resCol : supCol, width = lineW))

plot(nSide >= 1 ? r1 : na, "แนวต้าน 1", resCol, display = display.price_scale)
plot(nSide >= 2 ? r2 : na, "แนวต้าน 2", resCol, display = display.price_scale)
plot(nSide >= 3 ? r3 : na, "แนวต้าน 3", resCol, display = display.price_scale)
plot(nSide >= 1 ? s1 : na, "แนวรับ 1", supCol, display = display.price_scale)
plot(nSide >= 2 ? s2 : na, "แนวรับ 2", supCol, display = display.price_scale)
plot(nSide >= 3 ? s3 : na, "แนวรับ 3", supCol, display = display.price_scale)
