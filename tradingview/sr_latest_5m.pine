        tips += (tips == "" ? "" : "\n\n") + nE2 + " · ปิด " + f_px(e2C) + " ทะลุ" + sideK + " " + f_px(buy ? e2uL : e2dL) + "\n" + tp + (e2G == tSt ? "\n+ แท่งกลืนกิน = volume เยอะ · confirm §17" : "")
