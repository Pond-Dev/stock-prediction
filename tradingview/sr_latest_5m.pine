int evKeep = input.int(3, "ตาราง: ข้อความเหตุการณ์ค้างไว้กี่แท่ง", minval = 1, maxval = 20, group = G2, tooltip = "ใช้กับ \"มีจุดเข้า\" · \"ทะลุแต่ยังไม่เข้า\" · \"เนื้อปิดสวนเทรนด์\"\nเรื่องที่ต่อจาก Rejection (50% · Impulse Entry) แสดงแค่แท่งถัดไปแท่งเดียว ตาม confirm §8, §12")

color C_UP = #089981
color C_DN = #F23645
color C_GRAY = #787B86
color C_SIDE = #5D606B
color C_AMB = #FF9800
color C_INK = #131722
color C_NONE = color.new(#000000, 100)
int fs = uiSize == "เล็ก" ? 9 : uiSize == "กลาง" ? 11 : 13
bool atBody = drawAt == "เนื้อเทียน"
string tzUse = tzShow == "ตามตลาด" ? syminfo.timezone : tzShow
bool halfBody = rejHalf == "เนื้อ"
string halfTxt = halfBody ? "50% ของเนื้อแท่ง Rejection" : "50% ของแท่ง Rejection"
bool omChk = useOm and omCount
int nChk = omChk ? 5 : 4
int needPass = math.min(minPass, nChk)

type Zone
    float top
    float bot
    int t0
    int touch
    float wick

type Draw
    float top
    float bot
    int t0
    int touch
    int rank
    bool isRes
    float wick

type Grp
    float top
    float bot
    float wick
    string tfs
    string tip
    int maxRank
    int touch
    bool ent

f_add(array<Zone> a, float nt, float nb, float nw, int t, float tol, bool isRes) =>
    bool merged = false
    for z in a
        if nb - tol <= z.top and nt + tol >= z.bot
            z.top := math.max(z.top, nt)
            z.bot := math.min(z.bot, nb)
            z.wick := isRes ? math.max(z.wick, nw) : math.min(z.wick, nw)
            merged := true
            break
    if not merged
        a.push(Zone.new(nt, nb, t, 1, nw))
        if a.size() > 30
            a.shift()
    merged

f_compact(array<Zone> a, float tol, bool isRes) =>
    int i = a.size() - 1
    while i > 0
        Zone zi = a.get(i)
        for j = 0 to i - 1
            Zone zj = a.get(j)
            if zi.bot - tol <= zj.top and zi.top + tol >= zj.bot
                zj.top := math.max(zj.top, zi.top)
                zj.bot := math.min(zj.bot, zi.bot)
                zj.wick := isRes ? math.max(zj.wick, zi.wick) : math.min(zj.wick, zi.wick)
                zj.touch += zi.touch
                zj.t0 := math.min(zj.t0, zi.t0)
                a.remove(i)
                break
        i -= 1
    a.size()

f_near(array<Zone> a, bool isRes) =>
    float t1 = na
    float b1 = na
    int o1 = na
    int n1 = na
    float w1 = na
    for z in a
        float key = isRes ? z.bot : -z.top
        float k1 = isRes ? b1 : -t1
        if na(k1) or key < k1
            t1 := z.top
            b1 := z.bot
            o1 := z.t0
            n1 := z.touch
            w1 := z.wick
    [t1, b1, o1, n1, w1]

f_track(array<Zone> res, array<Zone> sup, int L, bool useBody, float mergeK) =>
    float bTop = math.max(open, close)
    float bBot = math.min(open, close)
    float ph = ta.pivothigh(useBody ? bTop : high, L, L)
    float pl = ta.pivotlow(useBody ? bBot : low, L, L)
    float bodyHi = ta.highest(bTop, 2 * L + 1)
    float bodyLo = ta.lowest(bBot, 2 * L + 1)
    float wickHi = ta.highest(high, 2 * L + 1)
    float wickLo = ta.lowest(low, 2 * L + 1)
    float atr = ta.atr(14)
    float tol = useBody ? mergeK * atr : 0.0
    float h1 = high[1]
    float l1 = low[1]
    int tPiv = time[L]
    float uL = na
    float uW = na
    float dL = na
    float dW = na
    int i = res.size() - 1
    while i >= 0
        Zone z = res.get(i)
        if close > z.top
            if na(uL) or z.top > uL
                uL := z.top
                uW := z.wick
            res.remove(i)
        else if high >= z.bot
            if h1 < z.bot
                z.touch += 1
            if not useBody and high > z.top
                z.top := high
                z.wick := high
        i -= 1
    int j = sup.size() - 1
    while j >= 0
        Zone z = sup.get(j)
        if close < z.bot
            if na(dL) or z.bot < dL
                dL := z.bot
                dW := z.wick
            sup.remove(j)
        else if low <= z.top
            if l1 > z.top
                z.touch += 1
            if not useBody and low < z.bot
                z.bot := low
                z.wick := low
        j -= 1
    if not na(ph)
        f_add(res, ph, useBody ? ph : math.min(bodyHi, ph - syminfo.mintick), useBody ? wickHi : ph, tPiv, tol, true)
    if not na(pl)
        f_add(sup, useBody ? pl : math.max(bodyLo, pl + syminfo.mintick), pl, useBody ? wickLo : pl, tPiv, tol, false)
    f_compact(res, tol, true)
    f_compact(sup, tol, false)
    [uL, uW, dL, dW]

f_src(int L, int off, bool useBody, float mergeK) =>
    var array<Zone> res = array.new<Zone>()
    var array<Zone> sup = array.new<Zone>()
    [_u1, _u2, _d1, _d2] = f_track(res, sup, L, useBody, mergeK)
    [rt, rb, ro, rn, rw] = f_near(res, true)
    [st, sb, so, sn, sw] = f_near(sup, false)
    [rt[off], rb[off], ro[off], rn[off], rw[off], st[off], sb[off], so[off], sn[off], sw[off]]

f_entry(int L, int off, bool useBody, float mergeK, int nBars, float tailK) =>
    var array<Zone> res = array.new<Zone>()
    var array<Zone> sup = array.new<Zone>()
    var int cUp = 0
    var int cDn = 0
    cUp := close > open ? cUp + 1 : 0
    cDn := close < open ? cDn + 1 : 0
    [uL, uW, dL, dW] = f_track(res, sup, L, useBody, mergeK)
    [rt, rb, ro, rn, rw] = f_near(res, true)
    [st, sb, so, sn, sw] = f_near(sup, false)
    float rng = math.max(high - low, syminfo.mintick)
    bool uOkW = close > uW
    bool uOkP = cUp < nBars
    bool uOkT = high - math.max(open, close) > tailK * rng
    bool dOkW = close < dW
    bool dOkP = cDn < nBars
    bool dOkT = math.min(open, close) - low > tailK * rng
    float atr = ta.atr(14)
    float body = math.abs(close - open)
    float relB = body / ta.sma(body, 20)[1]
    float uDist = (close - uL) / atr[1]
    float dDist = (dL - close) / atr[1]
    bool engUp = close > open and close[1] < open[1] and close[2] < open[2] and close > math.max(high[1], high[2])
    bool engDn = close < open and close[1] > open[1] and close[2] > open[2] and close < math.min(low[1], low[2])
    int eng = engUp ? 1 : engDn ? -1 : 0
    var float kU = na
    var int aU = 0
    var bool pU = false
    var bool nU = false
    var bool fU = false
    var float xU = na
    var float kD = na
    var int aD = 0
    var bool pD = false
    var bool nD = false
    var bool fD = false
    var float xD = na
    int keepN = math.max(retB, math.max(foN, runN))
    int rtU = 0
    int rtD = 0
    int fo = 0
    float foLv = na
    if not na(uL)
        kU := uL
        aU := 0
        pU := false
        nU := false
        fU := false
        xU := uDist
    else if not na(kU)
        aU += 1
        if aU > keepN
            kU := na
        else if close < kU
            if aU <= foN
                fo := 1
                foLv := kU
            kU := na
        else
            if not fU
                if not pU and low <= kU and close > open and aU <= retW
                    rtU := xU < midAtr ? 1 : 3
                    fU := true
                else if pU and nU and close > open and close[1] < open[1] and aU <= retB
                    rtU := 2
                    fU := true
            if close < open
                pU := true
            if low <= kU + nearK * atr
                nU := true
    if not na(dL)
        kD := dL
        aD := 0
        pD := false
        nD := false
        fD := false
        xD := dDist
    else if not na(kD)
        aD += 1
        if aD > keepN
            kD := na
        else if close > kD
            if aD <= foN and fo == 0
                fo := -1
                foLv := kD
            kD := na
        else
            if not fD
                if not pD and high >= kD and close < open and aD <= retW
                    rtD := xD < midAtr ? 1 : 3
                    fD := true
                else if pD and nD and close < open and close[1] > open[1] and aD <= retB
                    rtD := 2
                    fD := true
            if close > open
                pD := true
            if high >= kD - nearK * atr
                nD := true
    float rLvU = rtU > 0 ? kU : na
    float rLvD = rtD > 0 ? kD : na
    float avgB = ta.sma(body, 20)
    bool sz3 = body[2] >= c3Big * avgB[3] and body[1] <= c3Small * body[2]
    bool c3u = sz3 and close[2] > open[2] and close > open and close > math.max(high[1], high[2])
    bool c3d = sz3 and close[2] < open[2] and close < open and close < math.min(low[1], low[2])
    bool trU = not na(kU) and aU >= 3 and aU <= runN and math.min(low, math.min(low[1], low[2])) > kU + runGap * atr
    bool trD = not na(kD) and aD >= 3 and aD <= runN and math.max(high, math.max(high[1], high[2])) < kD - runGap * atr
    bool long3 = body > c3Long * body[2]
    int c3 = c3u ? (not trU ? 2 : long3 ? 3 : 1) : c3d ? (not trD ? -2 : long3 ? -3 : -1) : 0
    [uL[off], uW[off], uOkW[off], uOkP[off], uOkT[off], cUp[off], rb[off], dL[off], dW[off], dOkW[off], dOkP[off], dOkT[off], cDn[off], st[off], close[off], atr[off], time[off], relB[off], uDist[off], dDist[off], open[off], high[off], low[off], eng[off], rt[off], sb[off], rtU[off], rtD[off], rLvU[off], rLvD[off], fo[off], foLv[off], c3[off]]

f_trend(int L, int nTouch, int off) =>
    var int st = 0
    var float pk = na
    var float tr = na
    var float topH = na
    var float botL = na
    var float sup = na
    var float res = na
    var float boxT = na
    var float boxB = na
    var bool pulled = false
    var int touches = 0
    var bool touchPrev = false
    float bTop = math.max(open, close)
    float bBot = math.min(open, close)
    float ph = ta.pivothigh(bTop, L, L)
    float pl = ta.pivotlow(bBot, L, L)
    bool newPk = not na(ph)
    bool newTr = not na(pl)
    if newPk
        pk := ph
    if newTr
        tr := pl
    bool touch = false
    if st == 0
        if not na(pk) and close > pk
            st := 1
            topH := close
            sup := na(tr) ? bBot : tr
            pulled := false
            touches := 0
        else if not na(tr) and close < tr
            st := -1
            botL := close
            res := na(pk) ? bTop : pk
            pulled := false
            touches := 0
    else if st == 1
        if newTr
            pulled := true
            if tr > sup
                sup := tr
        if close < sup
            st := -1
            botL := close
            res := na(pk) ? topH : pk
            pulled := false
            touches := 0
        else if close > topH
            topH := close
            pulled := false
            touches := 0
        else
            touch := pulled and high >= topH
            if touch and not touchPrev
                touches += 1
            if touches >= nTouch
                st := 2
                boxT := topH
                boxB := sup
    else if st == -1
        if newPk
            pulled := true
            if pk < res
                res := pk
        if close > res
            st := 1
            topH := close
            sup := na(tr) ? botL : tr
            pulled := false
            touches := 0
        else if close < botL
            botL := close
            pulled := false
            touches := 0
        else
            touch := pulled and low <= botL
            if touch and not touchPrev
                touches += 1
            if touches >= nTouch
                st := 2
                boxT := res
                boxB := botL
    else
        if close > boxT
            st := 1
            topH := close
            sup := na(tr) or tr >= close ? boxB : tr
            pulled := false
            touches := 0
        else if close < boxB
            st := -1
            botL := close
            res := na(pk) or pk <= close ? boxT : pk
            pulled := false
            touches := 0
    touchPrev := touch
    float gUp = st == 1 ? topH : st == -1 ? res : st == 2 ? boxT : na
    float gDn = st == 1 ? sup : st == -1 ? botL : st == 2 ? boxB : na
    [st[off], gUp[off], gDn[off], touches[off]]

f_dir(int L, int nTouch, int off) =>
    [dSt, _g1, _g2, _g3] = f_trend(L, nTouch, off)
    dSt

f_setup(int L, int nTouch, int off) =>
    [est, eUp, eDn, _et] = f_trend(L, nTouch, 0)
    float atr = ta.atr(14)
    float body = math.abs(close - open)
    var int cu = 0
    var int cd = 0
    int cuP = cu
    int cdP = cd
    cu := close > open ? cu + 1 : 0
    cd := close < open ? cd + 1 : 0
    int tc = 0
    float tcLv = na
    float tcDi = na
    bool tcWk = false
    if est == -1 and est[1] == 1
        tc := -1
        tcLv := eDn[1]
        tcDi := (eDn[1] - close) / atr[1]
        tcWk := math.min(open, close) - low > body
    else if est == 1 and est[1] == -1
        tc := 1
        tcLv := eUp[1]
        tcDi := (close - eUp[1]) / atr[1]
        tcWk := high - math.max(open, close) > body
    int ft = 0
    if est == 1 and cdP >= 2 and close > open
        ft := body > body[1] ? 1 : 2
    else if est == -1 and cuP >= 2 and close < open
        ft := body > body[1] ? -1 : -2
    float ftTop = est == 1 ? eUp : est == -1 ? eDn : na
    int ftN = est == 1 ? cdP : cuP
    [tc[off], tcLv[off], tcDi[off], tcWk[off], ft[off], ftTop[off], ftN[off]]

f_tfName(string tf) =>
    float m = str.tonumber(tf)
    tf == "D" or tf == "1D" ? "Daily" : tf == "W" or tf == "1W" ? "Weekly" : na(m) ? tf : m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "m"

f_tfThai(string tf) =>
    float m = str.tonumber(tf)
    tf == "D" or tf == "1D" ? "Daily" : tf == "W" or tf == "1W" ? "Weekly" : na(m) ? tf : m % 60 == 0 ? str.tostring(m / 60) + " ชั่วโมง" : str.tostring(m) + " นาที"

f_px(float v) =>
    str.tostring(v, format.mintick)

f_range(float t, float b) =>
    t - b < syminfo.mintick ? f_px(t) : f_px(b) + " – " + f_px(t)

f_half(float o, float h, float l, float c) =>
    halfBody ? (o + c) / 2 : (h + l) / 2

f_pos(string p) =>
    p == "ขวาบน" ? position.top_right : p == "ขวากลาง" ? position.middle_right : p == "ขวาล่าง" ? position.bottom_right : p == "ซ้ายบน" ? position.top_left : position.bottom_left

f_ses(int h) =>
    h >= sesQuiet and h < sesAsia ? "ดึก · volume น้อย" : h >= sesAsia and h < sesLon ? "เอเชีย" : h >= sesLon and h < sesNy ? "ลอนดอน" : "นิวยอร์ก"

f_cell(table t, int c, int r, string txt, color tc, int sz, string ha, color bg, bool bold, string tip) =>
    table.cell(t, c, r, txt, text_color = tc, text_size = sz, text_halign = ha, bgcolor = bg, text_formatting = bold ? text.format_bold : text.format_none, tooltip = tip)

int secC = timeframe.in_seconds()
int secE1 = timeframe.in_seconds(tfE1)
int secE2 = timeframe.in_seconds(tfE2)
int stubN = int(math.max(8, math.min(60, math.round(4.0 * math.max(onE1 ? secE1 : 0, onE2 ? secE2 : 0) / math.max(secC, 1)))))
int o1 = timeframe.in_seconds(tf1) > secC ? 1 : 0
int o2 = timeframe.in_seconds(tf2) > secC ? 1 : 0
int o3 = timeframe.in_seconds(tf3) > secC ? 1 : 0
int o4 = timeframe.in_seconds(tf4) > secC ? 1 : 0
int oT = timeframe.in_seconds(tfT) > secC ? 1 : 0
int oE1 = secE1 > secC ? 1 : 0
int oE2 = secE2 > secC ? 1 : 0
[r1t, r1b, r1o, r1n, r1w, s1t, s1b, s1o, s1n, s1w] = request.security(syminfo.tickerid, tf1, f_src(swingLen, o1, atBody, mergeAtr), lookahead = o1 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[r2t, r2b, r2o, r2n, r2w, s2t, s2b, s2o, s2n, s2w] = request.security(syminfo.tickerid, tf2, f_src(swingLen, o2, atBody, mergeAtr), lookahead = o2 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[r3t, r3b, r3o, r3n, r3w, s3t, s3b, s3o, s3n, s3w] = request.security(syminfo.tickerid, tf3, f_src(swingLen, o3, atBody, mergeAtr), lookahead = o3 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[r4t, r4b, r4o, r4n, r4w, s4t, s4b, s4o, s4n, s4w] = request.security(syminfo.tickerid, tf4, f_src(swingLen, o4, atBody, mergeAtr), lookahead = o4 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[tSt, tUp, tDn, tTouch] = request.security(syminfo.tickerid, tfT, f_trend(trendLen, sideN, oT), lookahead = oT == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[e1uL, e1uW, e1uOkW, e1uOkP, e1uOkT, e1cU, e1rN, e1dL, e1dW, e1dOkW, e1dOkP, e1dOkT, e1cD, e1sN, e1C, e1A, e1T, e1RB, e1uD, e1dD, e1O, e1H, e1L, e1G, e1rT, e1sB, e1RtU, e1RtD, e1RLU, e1RLD, e1Fo, e1FoL, e1C3] = request.security(syminfo.tickerid, tfE1, f_entry(swingLen, oE1, atBody, mergeAtr, upBars, tailPct / 100), lookahead = oE1 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[e2uL, e2uW, e2uOkW, e2uOkP, e2uOkT, e2cU, e2rN, e2dL, e2dW, e2dOkW, e2dOkP, e2dOkT, e2cD, e2sN, e2C, e2A, e2T, e2RB, e2uD, e2dD, e2O, e2H, e2L, e2G, e2rT, e2sB, e2RtU, e2RtD, e2RLU, e2RLD, e2Fo, e2FoL, e2C3] = request.security(syminfo.tickerid, tfE2, f_entry(swingLen, oE2, atBody, mergeAtr, upBars, tailPct / 100), lookahead = oE2 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
int omS = request.security(symS, tfT, f_dir(trendLen, sideN, oT), lookahead = oT == 1 ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true)
int omD = request.security(symD, tfT, f_dir(trendLen, sideN, oT), lookahead = oT == 1 ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true)
[t1Tc, t1Lv, t1Di, t1Wk, t1Ft, t1Top, t1N] = request.security(syminfo.tickerid, tfE1, f_setup(trendLen, sideN, oE1), lookahead = oE1 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[t2Tc, t2Lv, t2Di, t2Wk, t2Ft, t2Top, t2N] = request.security(syminfo.tickerid, tfE2, f_setup(trendLen, sideN, oE2), lookahead = oE2 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
float atrC = ta.atr(14)

var array<string> names =array.from(f_tfName(tf1), f_tfName(tf2), f_tfName(tf3), f_tfName(tf4))
var array<int> widths = array.from(1, 1, 2, 3)
var array<int> fills = array.from(90, 87, 83, 78)
var array<bool> entTf = array.from((onE1 and tf1 == tfE1) or (onE2 and tf1 == tfE2), (onE1 and tf2 == tfE1) or (onE2 and tf2 == tfE2), (onE1 and tf3 == tfE1) or (onE2 and tf3 == tfE2), (onE1 and tf4 == tfE1) or (onE2 and tf4 == tfE2))

bool vis1 = onE1 and secE1 >= secC
bool vis2 = onE2 and secE2 >= secC
bool hasR = vis1 or vis2
bool rdIs1 = vis1 and (not vis2 or secE1 <= secE2)
string tfR = rdIs1 ? tfE1 : vis2 ? tfE2 : timeframe.period
int oR = rdIs1 ? oE1 : vis2 ? oE2 : 0
int secR = rdIs1 ? secE1 : vis2 ? secE2 : secC
string nT = f_tfThai(tfT)
string nE1 = f_tfThai(tfE1)
string nE2 = f_tfThai(tfE2)
string nR = f_tfThai(tfR)

f_omWord(int s) =>
    s == 1 ? "ขึ้น" : s == -1 ? "ลง" : s == 2 ? "Sideway" : "–"

f_omRead(int g, int s, int d) =>
    bool on = g == 1 or g == -1
    int sA = not on ? 0 : s == g ? 1 : s == -g ? -1 : 0
    int dA = not on ? 0 : d == -g ? 1 : d == g ? -1 : 0
    string txt = "Silver " + f_omWord(s) + (sA == 1 ? " ✓" : sA == -1 ? " ✗" : "") + " · DXY " + f_omWord(d) + (dA == 1 ? " ✓" : dA == -1 ? " ✗" : "")
    int ok = (sA == 1 ? 1 : 0) + (dA == 1 ? 1 : 0)
    int bad = (sA == -1 ? 1 : 0) + (dA == -1 ? 1 : 0)
    [txt, ok, bad]

f_omSum(int ok, int bad) =>
    "สอดคล้อง " + str.tostring(ok) + "/2" + (bad > 0 ? " · ขัด " + str.tostring(bad) : "")

f_omHead(bool counted) =>
    string r = ""
    if useOm
        [txt, ok, bad] = f_omRead(tSt, omS, omD)
        r := "\nตลาดอื่น " + nT + ": " + txt + " · " + f_omSum(ok, bad) + (counted ? " (นับเป็นเช็กข้อที่ 5)" : " (ประกอบ · ไม่นับในเช็ก)")
    r

bool chgR = timeframe.change(tfR)
int tcR = time_close(tfR)
int toR = time(tfR)
var float dO = na
var float dH = na
var float dL = na
if oR == 0 or chgR or na(dO)
    dO := open
    dH := high
    dL := low
else
    dH := math.max(dH, high)
    dL := math.min(dL, low)

f_push(array<Draw> a, bool on, float t, float b, int o, int n, float w, int rank, bool isRes) =>
    if on and not na(t) and not na(b) and not na(o)
        a.push(Draw.new(t, b, o, n, rank, isRes, w))
    a.size()

f_box(array<box> bx, Draw d) =>
    color c = d.isRes ? C_DN : C_UP
    bx.push(box.new(d.t0, d.top, time, d.bot, xloc = xloc.bar_time, extend = extend.right, border_color = c, border_width = widths.get(d.rank), bgcolor = color.new(C_GRAY, fills.get(d.rank))))
    bx.size()

f_overlap(Draw a, Draw b, float tol) =>
    a.bot - tol <= b.top and a.top + tol >= b.bot

f_groups(array<Draw> ds, float tol) =>
    array<Grp> out = array.new<Grp>()
    int n = ds.size()
    if n > 0
        array<int> grp = array.new<int>(n, -1)
        int g = 0
        for i = 0 to n - 1
            if grp.get(i) == -1
                grp.set(i, g)
                bool grew = true
                while grew
                    grew := false
                    for j = 0 to n - 1
                        if grp.get(j) == -1
                            for k = 0 to n - 1
                                if grp.get(k) == g and f_overlap(ds.get(j), ds.get(k), tol)
                                    grp.set(j, g)
                                    grew := true
                                    break
                g += 1
        for gi = 0 to g - 1
            float top = na
            float bot = na
            float wick = na
            string tfs = ""
            string tip = ""
            int maxRank = 0
            int touch = 0
            bool ent = false
            for r = 0 to 3
                for i = 0 to n - 1
                    Draw d = ds.get(i)
                    if grp.get(i) == gi and d.rank == r
                        top := na(top) ? d.top : math.max(top, d.top)
                        bot := na(bot) ? d.bot : math.min(bot, d.bot)
                        wick := na(wick) ? d.wick : d.isRes ? math.max(wick, d.wick) : math.min(wick, d.wick)
                        tfs += (tfs == "" ? "" : " + ") + names.get(r)
                        tip += names.get(r) + ":  " + f_range(d.top, d.bot) + "  · แตะ " + str.tostring(d.touch) + " ครั้ง\n"
                        maxRank := r
                        touch := math.max(touch, d.touch)
                        ent := ent or entTf.get(r)
            out.push(Grp.new(top, bot, wick, tfs, tip, maxRank, touch, ent))
    out

f_labels(array<label> lb, array<Grp> gs, bool isRes, int iNear, string tagEnt, string tagFree, int iPend) =>
    int n = gs.size()
    if n > 0
        string side = isRes ? "แนวต้าน " : "แนวรับ "
        string edge = atBody ? "เส้นอยู่ที่เนื้อเทียน (ราคาเปิด/ปิดสุด) ไม่นับไส้" : isRes ? "ขอบบน = ปลายไส้สูงสุด · ขอบล่าง = เนื้อเทียน · S/R §5" : "ขอบล่าง = ปลายไส้ต่ำสุด · ขอบบน = เนื้อเทียน · S/R §5"
        string brk = isRes ? "ทะลุ = แท่งของ TF นั้นปิดเหนือขอบบน แล้วโซนจะถูกลบ · S/R §8, §14" : "ทะลุ = แท่งของ TF นั้นปิดใต้ขอบล่าง แล้วโซนจะถูกลบ · S/R §8, §14"
        for i = 0 to n - 1
            Grp g = gs.get(i)
            string tag = not showTag ? "" : i == iPend ? "รอแท่ง " + g.tfs + " ปิด" : i == iNear ? (g.ent ? tagEnt : tagFree) : ""
            string txt = side + g.tfs + (showPx ? "\n" + f_range(g.top, g.bot) : "") + (tag == "" ? "" : "\n" + tag)
            string tipAll = side + g.tfs + "\n\n" + g.tip + "\n" + edge + "\n" + brk + "\nยิ่งเป็นโซนของ TF ใหญ่ ยิ่งสำคัญ · MTF §1\nยิ่งแตะหลายครั้งยิ่งห้ามเล่น · S/R §12" + (tag == "" ? "" : "\n\n" + tag + "\nรอแท่งปิดก่อนเสมอ ไส้ทะลุไม่นับ · S/R §3 · Trend §18")
            lb.push(label.new(bar_index + 2, isRes ? g.top : g.bot, txt, color = C_NONE, style = isRes ? label.style_label_lower_left : label.style_label_upper_left, textcolor = isRes ? C_DN : C_UP, size = g.maxRank >= 2 ? fs + 1 : fs, textalign = text.align_left, text_formatting = g.maxRank >= 2 ? text.format_bold : text.format_none, tooltip = tipAll))
    lb.size()

f_empty(array<label> lb, bool isRes) =>
    string txt = "ยังไม่มี" + (isRes ? "แนวต้าน" : "แนวรับ") + "ทางซ้ายมือ"
    string tip = "ราคาปิดทะลุโซนเดิมของทุก TF ไปหมดแล้ว · รอให้ราคากลับตัว" + (isRes ? "ลง" : "ขึ้น") + " แล้วจะเกิดโซนใหม่ · S/R คลิปวันที่ 7 นาที 50"
    lb.push(label.new(bar_index + 2, isRes ? high : low, txt, color = C_NONE, style = isRes ? label.style_label_lower_left : label.style_label_upper_left, textcolor = color.new(chart.fg_color, 20), size = fs, textalign = text.align_left, tooltip = tip))
    lb.size()

f_pick(array<Grp> a, bool isRes, float c) =>
    int i1 = -1
    int i2 = -1
    int ip = -1
    float k1 = na
    float k2 = na
    float kp = na
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Grp g = a.get(i)
            bool beyond = isRes ? c > g.top : c < g.bot
            float key = isRes ? g.bot : -g.top
            if beyond
                if ip == -1 or key > kp
                    ip := i
                    kp := key
            else if i1 == -1 or key < k1
                i2 := i1
                k2 := k1
                i1 := i
                k1 := key
            else if i2 == -1 or key < k2
                i2 := i
                k2 := key
    [i1, i2, ip]

f_hit(array<Grp> a, bool isRes, float bo, float bh, float bl) =>
    int ih = -1
    float kh = na
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Grp g = a.get(i)
            bool hit = isRes ? bh >= g.bot and bo <= g.top : bl <= g.top and bo >= g.bot
            float key = isRes ? g.bot : -g.top
            if hit and (ih == -1 or key > kh)
                ih := i
                kh := key
    ih

f_g(array<Grp> a, int i, bool isRes) =>
    float nr = na
    float fr = na
    string nm = ""
    int tc = 0
    bool en = false
    if i >= 0
        Grp g = a.get(i)
        nr := isRes ? g.bot : g.top
        fr := isRes ? g.top : g.bot
        nm := g.tfs
        tc := g.touch
        en := g.ent
    [nr, fr, nm, tc, en]

f_room(bool buy, float own, float px, float atrE, string tfN) =>
    array<float> zs = buy ? array.from(on1 ? r1b : na, on2 ? r2b : na, on3 ? r3b : na, on4 ? r4b : na) : array.from(on1 ? s1t : na, on2 ? s2t : na, on3 ? s3t : na, on4 ? s4t : na)
    float best = na
    string bestN = ""
    if not na(own) and (buy ? own > px : own < px)
        best := own
        bestN := tfN
    for k = 0 to 3
        float v = zs.get(k)
        if not na(v) and (buy ? v > px : v < px) and (na(best) or math.abs(v - px) < math.abs(best - px))
            best := v
            bestN := names.get(k)
    float room = na(best) ? na : math.abs(best - px) / atrE
    bool okR = na(best) or room >= roomAtr
    [okR, best, bestN, room]

f_eval(bool buy, float wick, bool okW, bool okP, bool okT, int cnt, float own, float px, float atrE, string tfN, float relB, float dist) =>
    [okR, best, bestN, room] = f_room(buy, own, px, atrE, tfN)
    [mTxt, mOk, mBad] = f_omRead(tSt, omS, omD)
    bool okM = omChk and mOk == 2
    int pass = (okW ? 1 : 0) + (okP ? 1 : 0) + (okT ? 1 : 0) + (okR ? 1 : 0) + (okM ? 1 : 0)
    string l6 = omChk ? "\n" + (okM ? "✓ " : "✗ ") + "ตลาดอื่น" + f_omSum(mOk, mBad) + ": " + mTxt + " · Bills §13" : ""
    string sideNext = buy ? "แนวต้าน" : "แนวรับ"
    string l1 = (okW ? "✓ ปิด" : "✗ ปิด") + (buy ? "เหนือ" : "ใต้") + "ไส้ซ้ายมือ " + f_px(wick) + (okW ? " ได้ = volume จริง" : " ไม่ได้ = volume ไม่จริง") + " · MTF §6"
    string l2 = (okP ? "✓ " : "✗ ") + (buy ? "ขึ้น" : "ลง") + "ติดกัน " + str.tostring(cnt) + " แท่ง" + (okP ? " = มีพักตัวมาก่อน" : " = ยังไม่พักตัว") + " · MTF §5"
    string l3 = (okT ? "✓ มีไส้" : "✗ ไม่มีไส้") + (buy ? "บน" : "ล่าง") + (okT ? "" : " = แท่งต่อไป 50/50") + " · MTF §9"
    string l4 = (okR ? "✓ " : "✗ ") + (na(best) ? "ซ้ายมือโล่ง ไม่มี" + sideNext + "ถัดไป" : sideNext + "ถัดไป " + bestN + " " + f_px(best) + " ห่าง " + str.tostring(room, "#.#") + " ATR" + (okR ? "" : " = ติดโซน")) + " · MTF §9"
    bool tooLong = relB > bigX
    bool tooFar = dist > farAtr
    bool okBig = not useBig or not (tooLong or tooFar)
    string l5 = (okBig ? "✓ " : "✗ ") + (tooLong or tooFar ? "แท่งยาวเกิน" : "แท่งพอดี") + ": เนื้อ " + str.tostring(relB, "#.#") + " เท่าของค่าเฉลี่ย 20 แท่ง · ปิดเลยแนว " + str.tostring(dist, "#.#") + " ATR" + (tooLong or tooFar ? (useBig ? " = ใช้แรงหมดในแท่งเดียว ไม่เข้า" : " (ปิดข้อนี้ไว้)") : "") + " · confirm §4, §7"
    bool tooNear = dist < nearAtr
    bool okNear = not useNear or not tooNear
    string star = tooNear ? "ปริ่มแนว" : dist < midAtr ? "★★★" : dist <= farAtr ? "★★" : "★"
    string starW = tooNear ? "ปิดปริ่มแนว = ใกล้ไป" : dist < midAtr ? "★★★ พอดี" : dist <= farAtr ? "★★ เริ่มไกล" : "★ ไกล = มีโอกาสกลับมา retest โซนเดิม"
    string l5b = (okNear ? "✓ " : "✗ ") + "ระยะเบรก: " + starW + " · ปิดเลยแนว " + str.tostring(dist, "#.##") + " ATR" + (tooNear ? (useNear ? " ไม่เข้า" : " (ปิดข้อนี้ไว้)") : "") + " · ท่าเทรด §2"
    bool okMust = okBig and okNear
    array<string> fl = array.new<string>()
    array<string> fr = array.new<string>()
    if not okBig
        fl.push(tooLong ? "แท่งยาวเกิน · เนื้อ " + str.tostring(relB, "#.#") + " เท่าของแท่งอื่น" : "แท่งยาวเกิน · ปิดเลยแนว " + str.tostring(dist, "#.#") + " ATR")
        fr.push("อย่าไล่ราคา · รอราคากลับมา")
    if not okNear
        fl.push("ปิดปริ่มแนว · เลยแนวแค่ " + str.tostring(dist, "#.##") + " ATR")
        fr.push("ใกล้ไป · รอแท่งที่ปิดเลยแนวชัด ๆ")
    if not okT
        fl.push("แท่งทะลุไม่มีไส้" + (buy ? "บน" : "ล่าง") + " = 50/50")
        fr.push("รอแท่งถัดไปที่มีไส้")
    if not okP
        fl.push((buy ? "ขึ้น" : "ลง") + "ติดกัน " + str.tostring(cnt) + " แท่ง")
        fr.push("รอพักตัวก่อน")
    if not okR
        fl.push("ติด" + sideNext + " " + bestN + " " + f_px(best))
        fr.push("ติดโซน · ยังเข้าไม่ได้")
    if not okW
        fl.push("ยังไม่ปิด" + (buy ? "เหนือ" : "ใต้") + "ไส้ซ้ายมือ " + f_px(wick))
        fr.push("volume ยังไม่จริง")
    if omChk and not okM
        fl.push("Silver / DXY ยังไม่สอดคล้องทั้งคู่")
        fr.push("ตลาดอื่นยังไม่หนุน")
    int nf = fl.size()
    [pass, "บังคับ:\n" + l5 + "\n" + l5b + "\n\nนับ " + str.tostring(pass) + "/" + str.tostring(nChk) + ":\n" + l1 + "\n" + l2 + "\n" + l3 + "\n" + l4 + l6, okMust, nf > 0 ? fl.get(0) : "", nf > 0 ? fr.get(0) : "", nf > 1 ? fl.get(1) : "", nf > 1 ? fr.get(1) : "", nf > 2 ? fl.get(2) : "", nf > 2 ? fr.get(2) : "", star]

f_rej(bool buy, float o, float h, float l, float c, bool okT, float own, float atrE, string tfN, bool ownX, string ownName) =>
    array<float> wNear = buy ? array.from(on1 ? s1t : na, on2 ? s2t : na, on3 ? s3t : na, on4 ? s4t : na) : array.from(on1 ? r1b : na, on2 ? r2b : na, on3 ? r3b : na, on4 ? r4b : na)
    array<float> wFar = buy ? array.from(s1b, s2b, s3b, s4b) : array.from(r1t, r2t, r3t, r4t)
    array<int> wCnt = buy ? array.from(s1n, s2n, s3n, s4n) : array.from(r1n, r2n, r3n, r4n)
    array<float> kNear = buy ? array.from(on1 ? r1b : na, on2 ? r2b : na, on3 ? r3b : na, on4 ? r4b : na) : array.from(on1 ? s1t : na, on2 ? s2t : na, on3 ? s3t : na, on4 ? s4t : na)
    string wN = ""
    int wT = 0
    string xN = ownX ? ownName : ""
    float wLv = na
    string kN = ""
    for k = 0 to 3
        float nr = wNear.get(k)
        float fr = wFar.get(k)
        if not na(nr)
            bool back = buy ? l <= nr and o > nr and c > nr : h >= nr and o < nr and c < nr
            bool bey = buy ? o >= fr and c < fr : o <= fr and c > fr
            if back
                wN += (wN == "" ? "" : " + ") + names.get(k)
                wT := math.max(wT, nz(wCnt.get(k)))
                wLv := na(wLv) ? nr : wLv
            if bey and not (ownX and names.get(k) == ownName)
                xN += (xN == "" ? "" : " + ") + names.get(k)
        float kr = kNear.get(k)
        if not na(kr)
            bool xb = buy ? h >= kr and o < kr and c < kr : l <= kr and o > kr and c > kr
            if xb
                kN += (kN == "" ? "" : " + ") + names.get(k)
    float body = math.abs(c - o)
    float upW = h - math.max(o, c)
    float loW = math.min(o, c) - l
    bool colOk = buy ? c > o : c < o
    bool longW = buy ? loW > body and loW > upW : upW > body and upW > loW
    bool isRej = wN != "" and colOk and longW
    [okR, best, bestN, room] = f_room(buy, own, c, atrE, tfN)
    int code = isRej ? (not okT ? 7 : not okR ? 8 : 3) : wN != "" ? 4 : xN != "" ? 5 : kN != "" ? 6 : 0
    string zn = code == 5 ? xN : code == 6 ? kN : wN
    string blk = ""
    if code == 3
        string wS = buy ? "แนวรับ" : "แนวต้าน"
        string kS = buy ? "แนวต้าน" : "แนวรับ"
        blk := tfN + " · ชน" + wS + " " + wN + " (แตะมาแล้ว " + str.tostring(wT) + " ครั้ง) แล้วปิดกลับ · ปิด " + f_px(c) + "\n✓ ปิด" + (buy ? "เขียว" : "แดง") + " ไส้" + (buy ? "ล่าง" : "บน") + "ยาวกว่าเนื้อ = Rejection · confirm §8\n✓ มีไส้" + (buy ? "บน" : "ล่าง") + " ไม่ใช่ 50/50 · แท่งเทียน §3\n✓ " + (na(best) ? "ซ้ายมือโล่ง ไม่มี" + kS + "ถัดไป" : kS + "ถัดไป " + bestN + " " + f_px(best) + " ห่าง " + str.tostring(room, "#.#") + " ATR") + " · MTF §9\n\nโน้ตเตือน: Rejection อย่างเดียวไม่ค่อยชัวร์ · confirm §9\nconfirm เพิ่มที่รอได้ในแท่งถัดไป:\n· " + (buy ? "ทะลุ high " + f_px(h) : "หลุด low " + f_px(l)) + " ของแท่งนี้ = Impulse Entry ไม่ต้องรอแท่งปิด · confirm §12 · MTF §2\n· เนื้อปิด" + (buy ? "เหนือ" : "ใต้") + kS + " = ทำลายโครงสร้าง confirm ทันที · confirm §9\n· เด้งไม่ควรเกิน " + halfTxt + " = " + f_px(f_half(o, h, l, c)) + " · confirm §8\nยิ่งแตะหลายครั้งยิ่งห้ามเล่น · S/R §12\n🤖 รูปทรงไส้เป็นของที่ AI ใส่เอง"
    [code, zn, wT, blk, colOk, wLv]

bool new1 = vis1 and e1T != e1T[1] and (oE1 == 1 or barstate.isconfirmed)
bool new2 = vis2 and e2T != e2T[1] and (oE2 == 1 or barstate.isconfirmed)
bool rdy = rdIs1 ? new1 : new2
bool trendOn = tSt == 1 or tSt == -1
bool buy = tSt == 1
var string lastTxt = "ยังไม่มี"
var string lastTip = "ยังไม่มีจุดเข้าในช่วงกราฟนี้"
var int lastDir = 0
var label entLb = na
var int entBar = na
var int entDir = 0
var bool entOff0 = false
var string entTfs = ""
var string entTip = ""
var string entStar = ""
var string evStar = ""
var int evCode = 0
var int evAge = 0
var int evSpan = 1
var int evDir = 0
var int evBar = na
var bool evOwn = false
var string evWho = ""
var string evZ = ""
var int evTouch = 0
var float evPx = na
var float evHi = na
var float evLo = na
var float evMid = na
var int evPass = 0
var bool evEng = false
var bool evWrong = false
var bool evIE = false
var bool evOver = false
var string evL1 = ""
var string evR1 = ""
var string evL2 = ""
var string evR2 = ""
var string evL3 = ""
var string evR3 = ""
var int cntBrk = 0
var int cntRej = 0
var int cntRet = 0
var int cntC3 = 0
var int cntTc = 0
var float entLv = na
var int entLvDir = 0
var string evKind = ""
var bool evIsBrk = true
bool newEv = false

if tSt != tSt[1]
    evCode := 0
    entLv := na

if trendOn
    string sideK = buy ? "แนวต้าน" : "แนวรับ"
    string act = buy ? "Buy" : "Sell"
    string okTf = ""
    string failTf = ""
    string tips = ""
    float pxE = na
    float lvE = na
    bool ok0 = false
    bool ok1 = false
    int passE = 0
    bool engE = false
    string starE = ""
    string retTf = ""
    int retK = 0
    float retLv = na
    float retPx = na
    string c3Tf = ""
    float c3Px = na
    bool foHit = false
    string foTf = ""
    float foPx = na
    string tcTf = ""
