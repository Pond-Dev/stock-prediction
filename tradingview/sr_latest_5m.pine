string OM_TEST = "🤖 ทดสอบทองคำ 4H 2 ปี (3,600 แท่ง): ช่วงที่สอดคล้อง 2/2 (44% ของเวลา) อีก 2 แท่งราคาไปตามเทรนด์เฉลี่ย +0.02 ATR ถูกทาง 49%\nช่วงที่มีตัวขัด (52% ของเวลา) +0.08 ATR ถูกทาง 52% = ไม่เห็นว่าสอดคล้องแล้วดีกว่า"
string G1 = "แสดงผล"
string G2 = "🤖 ค่าที่ AI ตั้ง (คลาสไม่ได้ให้ตัวเลข)"
bool on1 = input.bool(true, "", inline = "t1", group = G0)
string tf1 = input.timeframe("30", "TF 1", inline = "t1", group = G0, tooltip = "ชุด TF พื้นฐานที่ครูให้จด: Daily · 4H · 1H · 30 นาที (คลิปวันที่ 10 นาที 30)\nยิ่งเป็นโซนของ TF ใหญ่ ยิ่งสำคัญ · MTF §1")
bool on2 = input.bool(true, "", inline = "t2", group = G0)
string tf2 = input.timeframe("60", "TF 2", inline = "t2", group = G0)
bool on3 = input.bool(true, "", inline = "t3", group = G0)
string tf3 = input.timeframe("240", "TF 3", inline = "t3", group = G0)
bool on4 = input.bool(true, "", inline = "t4", group = G0)
string tf4 = input.timeframe("D", "TF 4", inline = "t4", group = G0, tooltip = "TF ยิ่งใหญ่ เส้นขอบยิ่งหนา")
string tfT = input.timeframe("240", "TF หาเทรนด์", group = GM, tooltip = "TF ใหญ่ใช้หาทิศ · MTF §3\nขาขึ้น = ทะลุยอดเดิม และจังหวะย่อไม่ปิดหลุดแนวรับล่าสุด · Trend §16–18\nแนวรับล่าสุด = ก้นของการย่อครั้งล่าสุด · Trend §18–19\nทะลุดูที่เนื้อเทียน ไส้หลุดไม่นับ · Trend §18\nปิดหลุดแนวรับล่าสุด = เปลี่ยนเป็นขาลงทันที · Trend §19\nขาลง = ขาขึ้นกลับด้าน · Trend §21\nชนยอดเดิมหลายรอบไม่ผ่าน = Sideway · Trend §6\nSideway หลุดขึ้น = ขาขึ้น · หลุดลง = ขาลง · Trend §14")
bool onE1 = input.bool(true, "", inline = "e1", group = GM)
string tfE1 = input.timeframe("60", "TF หาจุดเข้า 1", inline = "e1", group = GM, tooltip = "1 ชั่วโมงกับ 30 นาที ไม่ได้ดูเพื่อหา bias · ดูเพื่อหาจุดเข้าและโซนการเล่น · MTF §5")
bool onE2 = input.bool(true, "", inline = "e2", group = GM)
string tfE2 = input.timeframe("30", "TF หาจุดเข้า 2", inline = "e2", group = GM, tooltip = "จุดเข้า = แท่งของ TF นี้ปิดทะลุโซนของตัวเอง ไปทางเดียวกับเทรนด์ 4H\nป้ายขึ้นหลังแท่งของ TF นี้ปิดแล้ว · ดูบนกราฟ TF นี้หรือเล็กกว่า\nเทรนด์ 4H เป็น Sideway = ไม่หาจุดเข้า รอหลุดกรอบก่อน · Trend §14\nตารางอ่าน \"ตอนนี้\" จาก TF หาจุดเข้าตัวเล็กสุดที่ไม่เล็กกว่ากราฟ")
bool useBig = input.bool(true, "แท่งที่ทะลุยาวเกิน = ไม่เข้า", group = GM, tooltip = "แท่ง confirm ต้องพอดี ไม่ใหญ่ไม่เล็กเกิน · ใหญ่ไป = ใช้ระยะหมด · confirm §1, §4\nยิ่งทะลุไปไกลจากโซน ยิ่งมีโอกาสกลับตัว · แท่งทะลุที่ดีปิดห่างโซนนิดเดียว · confirm §7\nข้อนี้บังคับ: ไม่ผ่านแล้วไม่ขึ้นป้าย ต่อให้ข้ออื่นผ่านครบ\nข้อยกเว้นในคลาส (Sideway นาน 6–7 ชม. แท่งใหญ่เล่นได้ · confirm §6) ยังไม่ได้ใส่\nวันที่ 11 ครูพูดซ้ำเป็นเรื่อง Breakout: ยิ่งเบรกไกล ยิ่งมีโอกาสกลับไป retest โซนเดิม · ท่าเทรด §2")
bool useNear = input.bool(true, "แท่งที่ทะลุปิดปริ่มแนว = ไม่เข้า", group = GM, tooltip = "Breakout ที่ครูให้ดาว: ปิดเลยแนวพอดี ★★★ · เริ่มไกล ★★ · ไกล ★ · ท่าเทรด §2\n\"ใกล้ไป\" มีแบบเดียว คือปิดปริ่มโซน · ท่าเทรด §2 · ตัวอย่างกราฟจริงที่ครูบอกว่ายังไม่ได้เพราะปิดปริ่มโซน · ท่าเทรด §15\nข้อนี้บังคับ: ปิดปริ่มแนวแล้วไม่ขึ้นป้าย ต่อให้ข้ออื่นผ่านครบ\n🤖 คลาสไม่ได้ให้ตัวเลข · ระยะที่นับว่าปริ่มตั้งได้ในกลุ่ม 🤖\nทดสอบทองคำ 1H 2.4 ปี (ป้ายแบบทะลุ 271 ป้าย): ป้ายที่ปิดเลยแนวไม่ถึง 0.1 ATR (62 ป้าย) 4 แท่งถัดไปเฉลี่ย +0.02 ATR · ป้ายที่เหลือ +0.22 ATR\nแต่ดูไกล 8 แท่งกลับกัน (+0.40 เทียบ +0.13 ATR) = ผลปนกัน ยังไม่ชัดว่าตัดออกแล้วดีกว่า")
bool useRej =input.bool(true, "จุดเข้าแบบ Rejection", group = GM, tooltip = "ราคาวิ่งไปชนแนวแล้วโดนตบกลับ ทิ้งไส้ · confirm §8\nปิดเป็นแท่งฝั่งเดียวกับเทรนด์ 4H = มีโอกาสไปทางเทรนด์ เล่นได้ · รอแท่งปิดก่อน\nปิดเป็นแท่งสวนเทรนด์ = ยังไม่ควรเข้า\nโน้ตเตือนว่า Rejection อย่างเดียวไม่ค่อยชัวร์ · confirm §9\nไม่ขึ้นป้ายถ้าแท่งไม่มีไส้ฝั่งปิด (50/50 · แท่งเทียน §3) หรือติดโซนถัดไป (MTF §9)\n🤖 รูปทรงที่ AI ใส่เอง: ไส้ฝั่งที่โดนตบยาวกว่าเนื้อและยาวกว่าไส้อีกฝั่ง (คลิปวันที่ 9 นาที 29 · ยังไม่ได้ป้อน)\nทดสอบทองคำ 1H 2 ปี (119 ป้าย · ราว 1 ป้าย/สัปดาห์): 4 แท่งถัดไปเฉลี่ย -0.05 ATR · 8 แท่ง -0.13 ATR · ไปถูกทาง 55% = ยังไม่เห็นความได้เปรียบ\nรอ Impulse Entry ก่อนค่อยเข้าก็ไม่ดีกว่า (+0.04 / -0.23 ATR)\nเข้าที่เส้นทันทีที่ราคาแตะ ไม่รอแท่งปิด (1,704 ครั้ง): 4 แท่งถัดไปเฉลี่ย -0.01 ATR · ตั้ง SL กับ TP ห่าง 1 ATR เท่ากัน ชนะ 46% = ไม่ดีกว่ารอแท่งปิด\nฝั่งสวนเทรนด์ 4H (ชนแล้วปิดกลับ 1,490 ครั้ง): 4 แท่งถัดไปเฉลี่ย -0.18 ATR ไปถูกทาง 45% · ยิ่งเป็นแนวของ TF ใหญ่ยิ่งแย่ = สคริปต์จึงไม่ขึ้นป้ายฝั่งสวนเทรนด์")
bool useRet = input.bool(true, "จุดเข้าแบบ Break & Retest ด้วยไส้", group = GM, tooltip = "Breakout มี 2 แบบ: เบรกแล้วไปเลย กับเบรกแล้วกลับมา retest โซนเดิม · ท่าเทรด §1\nRetest ด้วยไส้: แท่งหลังเบรกลงมาแตะแนวเดิม ทิ้งไส้ แล้วปิดกลับเป็นแท่งตามเทรนด์ · ครูชอบแบบนี้เพราะเบรกแล้วอยากให้ไปเลย · ท่าเทรด §5–§6\nครูเข้าแบบ Impulse Entry ตอนทะลุ high แท่งก่อนหน้า · ป้ายนี้ขึ้นหลังแท่งปิด จึงช้ากว่าที่ครูเข้า\nไม่ขึ้นป้ายถ้าแท่งเบรกปิดไกล (★★ ขึ้นไป): ครูไม่ชอบให้แท่งเบรกไกล เพราะแรงอาจหมด · ท่าเทรด §5\nทดสอบทองคำ 1H 2.4 ปี ตามเทรนด์ 4H: แท่งเบรกไม่ไกล (146 ครั้ง · ราว 1.2 ครั้ง/สัปดาห์) 4 แท่งถัดไปเฉลี่ย +0.06 ATR · 8 แท่ง +0.29 ATR · ไปถูกทาง 53% = ได้เปรียบน้อย\nแท่งเบรกไกล (19 ครั้ง) 4 แท่ง -0.63 ATR = ตรงกับที่ครูเตือน แต่ตัวอย่างน้อย")
bool showRetB = input.bool(false, "แสดง Retest ด้วยเนื้อเทียน (ยังไม่ใช่จุดเข้า)", group = GM, tooltip = "ปิดไว้เป็นค่าเริ่มต้นเพื่อไม่ให้กราฟรก · ตารางยังบอกเมื่อเกิดขึ้น\nRetest ด้วยเนื้อ: เบรกไปก่อน แล้วแท่งสวนทางย่อกลับมาที่แนวเดิม แล้วเกิดแท่งตามเทรนด์ = ต้านเปลี่ยนเป็นรับ (หรือรับเปลี่ยนเป็นต้าน) แปลว่าโซนนี้มีนัยยะสำคัญสูงมาก · ท่าเทรด §4\nครูยังไม่เข้าตรงนี้เพราะมักติดแนวของยอดแท่งเบรก · ครูรอเบรกแนวนั้นอีกทีค่อยเข้า · ป้ายจึงเป็นสีเทา ไม่นับเป็นจุดเข้า\nทดสอบทองคำ 1H 2.4 ปี ตามเทรนด์ 4H (151 ครั้ง): 4 แท่งถัดไปเฉลี่ย +0.09 ATR · 8 แท่ง +0.24 ATR · ไปถูกทาง 57% · ฝั่งสวนเทรนด์ -0.18 ATR")
bool useC3 = input.bool(true, "จุดเข้าแบบ 3 แท่งมหาประลัย", group = GM, tooltip = "ต้องเกิดตอนราคาวิ่งเป็นเทรนด์เท่านั้น · เกิดใน Sideway ไม่นับ · เกิดตรงขอบกรอบหลังเบรก = Break & Retest ไม่ใช่ 3 แท่ง · ท่าเทรด §16\n3 ข้อ: แท่งแรกใหญ่ · แท่งสองเล็ก (ยิ่งเล็กยิ่งดี) · แท่งสามปิดเลยไส้ของแท่งแรกและแท่งสอง · ท่าเทรด §17\nไม่ดี: แท่งสามปิดยาวเกิน = ขึ้นมาเยอะอีกแล้ว · ท่าเทรด §19\nป้ายขึ้นหลังแท่งสามปิด (แบบรอปิดแท่ง) · ครูเข้าแบบ Impulse Entry ได้ด้วย · ท่าเทรด §18\n🤖 \"วิ่งเป็นเทรนด์\" ในสคริปต์ = ทิศเดียวกับเทรนด์ 4H + แท่งของ TF นี้เบรกแนวของตัวเองไปแล้ว 3 แท่งขึ้นไป + ทั้ง 3 แท่งอยู่ห่างจากแนวที่เบรก · ตัวเลขอยู่ในกลุ่ม 🤖\nทดสอบทองคำ 1H 2.4 ปี: ครบ 3 ข้อและวิ่งเป็นเทรนด์ (27 ครั้ง · ราวเดือนละครั้ง) 4 แท่งถัดไปเฉลี่ย +0.71 ATR · 8 แท่ง +0.81 ATR · ไปถูกทาง 67%\nครบ 3 ข้อแต่อยู่ขอบกรอบ (170 ครั้ง) -0.09 ATR · ไม่มีการเบรกมาก่อน (118 ครั้ง) +0.01 ATR = ตรงกับที่ครูบอกว่าต้องเกิดตอนวิ่งเป็นเทรนด์ · แต่ 27 ครั้งยังน้อย")
bool useTc = input.bool(true, "จุดเข้าแบบ Trend Change และท่าที่ 6", group = GM, tooltip = "Trend Change (TC): ขาขึ้นปิดต่ำกว่าแนวรับล่าสุด = ขาลง · ไม่ต้องรอแนวรับตัวล่าง · ท่าเทรด §14 · Trend §19\nป้ายขึ้นเมื่อโครงสร้างของ TF หาจุดเข้าพลิกกลับมาทางเดียวกับเทรนด์ 4H (จบจังหวะย่อสวนเทรนด์)\nโครงสร้างของ TF หาจุดเข้าอ่านด้วยวิธีเดียวกับเทรนด์ 4H · Trend §16–21\nไม่ขึ้นป้ายถ้าปิดปริ่มแนว หรือไส้ฝั่งที่ทะลุยาวกว่าเนื้อ (volume ไม่ได้เยอะขนาดนั้น) · ท่าเทรด §15\nท่าที่ 6 = Trend Change ที่แท่งเปลี่ยนเทรนด์ใหญ่มาก กลืนไปหมด · ครูรอแท่งถัดไปทำไส้อีกฝั่งแล้วเข้า Impulse Entry · ท่าเทรด §20\n🤖 สคริปต์นับเป็นท่าที่ 6 เมื่อแท่งนั้นปิดเลยแนวเกินค่า \"แท่งยาวเกิน: ปิดเลยแนว\" ในกลุ่ม 🤖 · ป้ายขึ้นที่แท่งเปลี่ยนเทรนด์ ก่อนจังหวะที่ครูเข้า\nทดสอบทองคำ 1H 2.4 ปี: ป้าย TC ที่ผ่านเงื่อนไข (148 ครั้ง · ราว 1.2 ครั้ง/สัปดาห์) 4 แท่งถัดไปเฉลี่ย +0.06 ATR · 8 แท่ง +0.14 ATR · ไปถูกทาง 50% = ยังไม่เห็นความได้เปรียบ\nไส้ยาวกว่าเนื้อ (27 ครั้ง) -0.20 ATR ไปถูกทาง 37% = ตรงกับที่ครูบอกว่ายังไม่ได้\nท่าที่ 6 (22 ครั้ง) 4 แท่ง +0.50 ATR · 8 แท่ง +0.77 ATR · ไปถูกทาง 64% · ตัวอย่างยังน้อย")
bool useFt = input.bool(false, "จุดเข้าแบบ Follow Trend (ป้ายบนกราฟ)", group = GM, tooltip = "Follow Trend: ขาขึ้น ทำแนวต้าน ย่อ แล้วทำแนวรับ มีโอกาส 80% กลับไป retest high เดิม · ขาลงกลับกัน · ท่าเทรด §10 · Trend §5\nดู volume ต้องเทียบกับแท่งก่อนหน้า: แท่งที่กลับตัวควรใหญ่กว่าแท่งก่อนหน้า · ท่าเทรด §11\nสคริปต์จับ: โครงสร้างของ TF หาจุดเข้าไปทางเดียวกับเทรนด์ 4H + ย่อสวนเทรนด์อย่างน้อย 2 แท่ง + เกิดแท่งตามเทรนด์ที่เนื้อใหญ่กว่าแท่งก่อนหน้า\nปิดป้ายไว้เพราะเกิดบ่อยมาก (ราว 3.8 ครั้ง/สัปดาห์ต่อ TF) · ตารางยังบอกเมื่อเกิดขึ้น\nทดสอบทองคำ 1H 2.4 ปี (469 ครั้ง): 4 แท่งถัดไปเฉลี่ย +0.06 ATR · 8 แท่ง +0.22 ATR · ไปถูกทาง 50% = ได้เปรียบน้อย\nแท่งกลับตัวเล็กกว่าแท่งก่อนหน้า (387 ครั้ง): +0.01 / +0.07 ATR = ใหญ่กว่าแท่งก่อนหน้าดีกว่าเล็กน้อย ตรงกับที่ครูสอน")
bool showFo = input.bool(false, "แสดงป้าย Fakeout ของป้าย Breakout", group = GM, tooltip = "Fakeout = เบรกออกไปแล้วกลับเข้ามาปิดในโซนเดิม · ท่าเทรด §7\nครูไม่ค่อยเล่น Fakeout และบอกว่าอย่าเล่นตอนราคาวิ่งเป็นเทรนด์ ให้เล่นเฉพาะ Sideway จริง ๆ · ท่าเทรด §8–§9\nสคริปต์หาจุดเข้าตามเทรนด์ 4H จึงไม่ทำป้ายจุดเข้าแบบ Fakeout · ตารางจะบอกเมื่อป้าย Breakout ล่าสุดโดนปิดกลับเข้าแนว\nเปิดข้อนี้ = ขึ้นป้ายเทาบนกราฟด้วย (ปิดไว้เพราะเกิดบ่อย)\nทดสอบทองคำ 1H 2.4 ปี: ป้าย Breakout 166 จาก 271 ป้าย (61%) โดนปิดกลับเข้าแนวภายใน 6 แท่ง แต่หลังจากนั้น 4 แท่งราคายังไปตามเทรนด์เฉลี่ย +0.14 ATR (8 แท่ง +0.29) = โดนปิดกลับแล้วไม่ได้แปลว่าต้องสวน\nเล่น Fakeout กลับเข้ากรอบทางเดียวกับเทรนด์ 4H (345 ครั้ง): 4 แท่ง +0.04 ATR · 8 แท่ง -0.07 ATR = ไม่เห็นความได้เปรียบ")
bool showPanel = input.bool(true, "ตาราง: ตอนนี้ · กำลังรอ", group = GM)
bool showFail = input.bool(false, "แสดงจุดที่ทะลุแนว แต่ยังไม่เข้า", group = GM, tooltip = "ป้ายสีเทา · ชี้เมาส์ดูว่าข้อไหนไม่ผ่าน")
