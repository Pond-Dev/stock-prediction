        tips += (tips == "" ? "" : "\n\n") + nE1 + " · ปิด " + f_px(e1C) + " ทะลุ" + sideK + " " + f_px(buy ? e1uL : e1dL) + "\n" + tp + (e1G == tSt ? "\n+ แท่งกลืนกิน = volume เยอะ · confirm §17" : "")
        pxE := e1C
        if p >= needPass and big
