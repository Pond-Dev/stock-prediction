        string gK = tSt == 1 ? "เปลี่ยนเป็นขาลง ถ้าปิดใต้" : tSt == -1 ? "เปลี่ยนเป็นขาขึ้น ถ้าปิดเหนือ" : tSt == 2 ? "กรอบ Sideway" : "รอโครงสร้าง"
        string gV = tSt == 1 ? f_px(tDn) : tSt == -1 ? f_px(tUp) : tSt == 2 ? f_px(tDn) + " – " + f_px(tUp) : "-"
        string gTip = tSt == 1 ? "แนวรับล่าสุดของ " + nT + " (ก้นของการย่อครั้งล่าสุด)\nแท่ง " + nT + " ปิดใต้เส้นนี้ = เปลี่ยนมุมมองเป็นขาลงทันที · Trend §19\nยอดเดิม (ด่านแรก) " + f_px(tUp) + " · Trend §6" : tSt == -1 ? "แนวต้านล่าสุดของ " + nT + " (ยอดของการเด้งครั้งล่าสุด)\nแท่ง " + nT + " ปิดเหนือเส้นนี้ = เปลี่ยนมุมมองเป็นขาขึ้น · Trend §21\nก้นเดิม " + f_px(tDn) : tSt == 2 ? "Sideway = พักตัว สะสมแรง · Set Zero\nหลุดขึ้น = ขาขึ้น · หลุดลง = ขาลง · Trend §14" : "รอให้ราคาทำยอดและก้นก่อน"
        string dotTip = "● = confirm ที่มีแล้ว · ○ = ยังรอ\nคลาส: ต้องมี confirm ประมาณ 3–4 อย่าง ใช้แทนกันได้ · confirm §13\nคลาสยังไม่ได้บอกว่าเช็กลิสต์มีข้ออะไรบ้าง\n🤖 รายการนี้ AI เลือกจากสิ่งที่โน้ตเรียกว่า confirm: เทรนด์ TF ใหญ่ · แนวรับแนวต้าน · แท่ง confirm / Rejection / Impulse Entry / กลืนกิน\nตารางไม่ตัดสินว่าครบหรือไม่ครบ"
        bool stale = lastDir != 0 and trendOn and lastDir != tSt
        table.clear(tb, 0, 0, 1, 8)
        f_cell(tb, 0, 0, "เทรนด์ " + nT, fg, fs, AL, nob, false, trTip)
        f_cell(tb, 1, 0, chip, color.white, fs, AC, cT, true, trTip)
        f_cell(tb, 0, 1, gK, sub, fs - 1, AL, nob, false, gTip)
        f_cell(tb, 1, 1, gV, fg, fs, AC, nob, true, gTip)
        if useOm
            [omTxt, omOk, omBad] = f_omRead(tSt, omS, omD)
            string omSub = trendOn ? f_omSum(omOk, omBad) + (omChk and omOk == 2 ? " · ได้ 1 ข้อ" : "") : "ทองยังไม่มีทิศให้เทียบ"
            color omFg = omBad > 0 ? C_AMB : omOk == 2 ? fg : sub
            string omTip = "เทรนด์ " + nT + " ของ Silver (" + symS + ") และ DXY (" + symD + ")\nสคริปต์ดึงมาอ่านเอง ไม่ต้องเปิดกราฟเพิ่ม · อ่านด้วยวิธีเดียวกับทอง · Trend §16–21\n✓ = สอดคล้องกับเทรนด์ทอง (Silver ไปทางเดียวกัน · DXY สวนทาง)\n✗ = ขัดกับเทรนด์ทอง\nไม่มีเครื่องหมาย = Sideway หรือยังอ่านไม่ได้\nที่มา: คลิป Bills (นอกคลาส) ใช้ silver กับ DXY เป็น confluence ฝั่ง fundamental · Bills §13\nconfluence เดียวไม่ใช่ confirmation · Bills §13\n" + (omChk ? "สอดคล้อง 2/2 = นับเป็นเช็กข้อที่ 5 ของจุดเข้าแบบทะลุ · ปิดได้ใน Settings" : "ใช้ประกอบเท่านั้น · ไม่นับในเช็กจุดเข้า") + "\n🤖 ความสัมพันธ์ไม่คงที่ บางช่วงทองกับ DXY ขึ้นพร้อมกันได้\n" + OM_TEST
            f_cell(tb, 0, 2, "ตลาดอื่น · " + nT, sub, fs - 1, AL, nob, false, omTip)
            f_cell(tb, 1, 2, omTxt + "\n" + omSub, omFg, fs - 1, AC, nob, false, omTip)
        f_cell(tb, 0, 3, "ตอนนี้ · " + nR + clk + "\n" + ln1 + "\n" + ln2, phFg, fs, AL, phBg, true, phTip + clkTip)
        table.merge_cells(tb, 0, 3, 1, 3)
        f_cell(tb, 0, 4, dots, sub, fs - 1, AL, nob, false, dotTip)
        table.merge_cells(tb, 0, 4, 1, 4)
        for i = 0 to 2
            if i < rl.size()
                f_cell(tb, 0, 5 + i, rl.get(i), fg, fs - 1, AL, nob, false, rt.get(i))
                f_cell(tb, 1, 5 + i, rr.get(i), sub, fs - 1, AL, nob, false, rt.get(i))
        f_cell(tb, 0, 8, "จุดเข้าล่าสุด", sub, fs - 1, AL, nob, false, lastTip)
        f_cell(tb, 1, 8, lastTxt + (stale ? "\n(ก่อนเทรนด์เปลี่ยน)" : ""), stale ? color.new(chart.fg_color, 50) : fg, fs - 1, AL, nob, false, lastTip + (stale ? "\n\nจุดเข้านี้เกิดก่อนเทรนด์ " + nT + " เปลี่ยน · ทิศที่หาตอนนี้ดูจากแถวบนสุด" : ""))

