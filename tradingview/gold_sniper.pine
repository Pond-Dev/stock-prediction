//@version=6
indicator("Gold Sniper", shorttitle="Gold Sniper", overlay=true, max_bars_back=500, max_boxes_count=20)

int strength = input.int(2, "M5 swing confirmation bars", minval=1, maxval=5)
float width = input.float(0.15, "Zone half-width / M5 ATR", minval=0.05, maxval=0.5, step=0.05)
float minRoom = input.float(1.0, "Minimum room to opposing zone / M1 ATR", minval=0.25, maxval=5.0, step=0.25)
int expiry = input.int(3, "Setup valid for next N M1 bars", minval=1, maxval=10)
int cooldown = input.int(3, "Full bars to skip after signal", minval=0, maxval=20)
bool showHistory = input.bool(true, "Show historical candidates (gray H)")
bool showZones = input.bool(true, "Show active zones")
bool useOB = input.bool(true, "Add M1 internal Order Block zones (SMC)")
bool useSession = input.bool(true, "Only arm new setups during session")
string sessionHours = input.session("0800-1130,1330-1700", "Session hours (exchange tz below)")
string sessionTz = input.string("America/New_York", "Session timezone")

if barstate.isfirst and (not timeframe.isminutes or timeframe.multiplier != 1 or not chart.is_standard)
    runtime.error("Use standard 1-minute candles.")

float a = ta.atr(14)[1]
float tick = syminfo.mintick
float pad = math.max(2 * tick, a * 0.05)
// Session gate uses the exchange timezone directly, DST-adjusted by Pine,
// instead of a hardcoded local clock time that would drift with DST.
bool inSession = not useSession or not na(time(timeframe.period, sessionHours, sessionTz))
// Every requested expression is offset. Pivots become usable only AFTER
// strength M5 bars have closed to their right. Never backdate a zone or signal.
[pl, ph, ma, mt, m5Close, m5Fast, m5Slow] = request.security(syminfo.tickerid, "5", [ta.pivotlow(low, strength, strength)[1], ta.pivothigh(high, strength, strength)[1], ta.atr(14)[1], time[1], close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1]], lookahead=barmerge.lookahead_on)
// EMA 20/50 regime: both slopes agree, gap >= 0.10 ATR, M5 confirms. Display only, not a gate.
float fast = ta.ema(close, 20)
float slow = ta.ema(close, 50)
bool trendUp = fast > slow and fast > fast[3] and slow >= slow[3] and fast - slow >= a * 0.10 and m5Close > m5Fast and m5Fast > m5Slow
bool trendDown = fast < slow and fast < fast[3] and slow <= slow[3] and slow - fast >= a * 0.10 and m5Close < m5Fast and m5Fast < m5Slow
varip array<float> bottoms = array.new_float()
varip array<float> tops = array.new_float()
varip array<int> sides = array.new_int()
varip array<int> kinds = array.new_int() // 0 = M5 pivot zone, 1 = M1 internal order block
varip array<int> births = array.new_int()
varip array<bool> available = array.new_bool()
varip array<int> touches = array.new_int() // completed visits: price entered the zone, counted once per visit
varip array<bool> touching = array.new_bool()
varip int lastM5 = na
var int structure = 0 // M1 internal structure: 0 until the first break, then +1 bullish / -1 bearish

f_remove(int i) =>
    array.remove(bottoms, i)
    array.remove(tops, i)
    array.remove(sides, i)
    array.remove(kinds, i)
    array.remove(births, i)
    array.remove(available, i)
    array.remove(touches, i)
    array.remove(touching, i)

// Break lean per zone: structure pointing through it, EMA pointing through it,
// third or later test. Two of three = likely BREAK, otherwise likely HOLD.
// ponytail: naive 3-factor vote, tune weights once two weeks of signals are logged.
f_breakLean(int side, int n) =>
    int score = (structure == -side ? 1 : 0) + ((side == 1 ? fast < slow : fast > slow) ? 1 : 0) + (n >= 3 ? 1 : 0)
    score >= 2

f_addZone(float lo, float hi, int side, int kind) =>
    // Do not stack overlapping zones of the same side. Existing bounds stay fixed.
    bool overlap = false
    if array.size(sides) > 0
        for i = 0 to array.size(sides) - 1
            if array.get(sides, i) == side and lo <= array.get(tops, i) and hi >= array.get(bottoms, i)
                overlap := true
    if not overlap and not na(lo) and not na(hi)
        array.push(bottoms, lo)
        array.push(tops, hi)
        array.push(sides, side)
        array.push(kinds, kind)
        array.push(births, time)
        array.push(available, true)
        array.push(touches, 0)
        array.push(touching, false)
        if array.size(sides) > 12
            f_remove(0)

f_add(float price, int side) =>
    float halfWidth = math.max(2 * tick, ma * width)
    f_addZone(price - halfWidth, price + halfWidth, side, 0)

// na means no opposing zone was found, NOT unlimited profit potential.
f_room(int side, float price) =>
    float room = na
    if array.size(sides) > 0
        for i = 0 to array.size(sides) - 1
            float lo = array.get(bottoms, i)
            float hi = array.get(tops, i)
            if array.get(sides, i) == -side and (side == 1 ? hi >= price : lo <= price)
                float distance = math.max(0, side == 1 ? lo - price : price - hi)
                room := na(room) ? distance : math.min(room, distance)
    room

if not na(mt) and (na(lastM5) or mt != lastM5)
    lastM5 := mt
    if not na(pl)
        f_add(pl, 1)
    if not na(ph)
        f_add(ph, -1)

varip int pending = 0
varip int armed = na
varip int zoneBirth = na
varip float entry = na
varip float invalid = na
varip float setupAtr = na
varip int lastSignal = na
varip bool started = false
varip int signalSide = 0
varip float signalPrice = na
varip bool liveSignal = false
varip bool ended = false
varip int readySide = 0
varip string status = "Waiting for zone rejection"

if barstate.isnew or (barstate.isrealtime and not started)
    signalSide := 0
    signalPrice := na
    liveSignal := false
    ended := false
    readySide := 0

if pending != 0 and bar_index > armed
    bool exists = false
    if array.size(sides) > 0
        for i = 0 to array.size(sides) - 1
            if array.get(births, i) == zoneBirth and array.get(sides, i) == pending
                exists := true
    bool touched = pending == 1 ? high >= entry : low <= entry
    bool invalidHit = pending == 1 ? low <= invalid : high >= invalid
    bool stale = barstate.isrealtime and not started and touched
    bool gap = time - time[1] > 60000
    float observed = barstate.isrealtime ? close : (pending == 1 ? math.max(open, entry) : math.min(open, entry))
    float room = f_room(pending, observed)
    float triggerRoom = f_room(pending, entry)
    bool roomOK = (na(room) or room >= setupAtr * minRoom) and (na(triggerRoom) or triggerRoom >= setupAtr * minRoom)
    if not exists or invalidHit or stale or gap or bar_index - armed > expiry or time - zoneBirth >= 28800000
        status := stale ? "Skipped old crossing" : "Setup canceled / expired"
        pending := 0
        ended := true
    else if touched
        float overshoot = pending == 1 ? observed - entry : entry - observed
        bool through = pending == 1 ? observed >= entry : observed <= entry
        if through and overshoot <= setupAtr * 0.15 and roomOK
            signalSide := pending
            signalPrice := entry
            liveSignal := barstate.isrealtime
            lastSignal := bar_index
            status := liveSignal ? (pending == 1 ? "BUY triggered" : "SELL triggered") : "Historical candidate"
            if barstate.isrealtime
                alert("Gold Sniper | " + syminfo.tickerid + " | M1 | " + (pending == 1 ? "BUY" : "SELL") + " | Trigger=" + str.tostring(entry, format.mintick) + " | Observed=" + str.tostring(close, format.mintick) + (pending * structure < 0 ? " | AGAINST STRUCTURE" : ""), alert.freq_once_per_bar)
        else
            status := roomOK ? "Skipped missed / extended break" : "Opposing zone too close"
        pending := 0
        ended := true

if barstate.isrealtime
    started := true

// M1 internal structure ported from LuxAlgo SMC: 5-bar leg swings, a break is an
// M1 close through the last swing, the order block is the extreme candle between
// that swing and the break. Volatile candles (range >= 2x ATR200) are inverted so
// they are never picked, same as the original.
float atr200 = ta.atr(200)
bool volatile = high - low >= 2 * atr200
float pHigh = volatile ? low : high
float pLow = volatile ? high : low
int lowOff = -ta.lowestbars(pLow, 6)
int highOff = -ta.highestbars(pHigh, 6)
var int leg = 0
int legPrev = leg
bool newLegHigh = high[5] > ta.highest(high, 5)
bool newLegLow = low[5] < ta.lowest(low, 5)
if newLegHigh
    leg := 0
else if newLegLow
    leg := 1
var float swingHi = na
var float swingLo = na
var bool hiCrossed = true
var bool loCrossed = true
var float obLow = na
var float obLowTop = na
var float obHigh = na
var float obHighBottom = na

// Remove zones on an M1 CLOSE through their far edge, or after eight hours.
// Wicks may sweep a zone and recover; broken zones are not flipped automatically.
if barstate.isconfirmed
    if leg == 0 and legPrev == 1
        swingHi := high[5]
        hiCrossed := false
        obLow := pLow[lowOff]
        obLowTop := pHigh[lowOff]
    if leg == 1 and legPrev == 0
        swingLo := low[5]
        loCrossed := false
        obHigh := pHigh[highOff]
        obHighBottom := pLow[highOff]
    if not hiCrossed and close > swingHi
        hiCrossed := true
        structure := 1
        if useOB and obLowTop - obLow > 0 and obLowTop - obLow <= a * 1.5
            f_addZone(obLow, obLowTop, 1, 1)
    if not loCrossed and close < swingLo
        loCrossed := true
        structure := -1
        if useOB and obHigh - obHighBottom > 0 and obHigh - obHighBottom <= a * 1.5
            f_addZone(obHighBottom, obHigh, -1, 1)
    if pLow < obLow
        obLow := pLow
        obLowTop := pHigh
    if pHigh > obHigh
        obHigh := pHigh
        obHighBottom := pLow

    int i = array.size(sides) - 1
    while i >= 0
        int side = array.get(sides, i)
        float lo = array.get(bottoms, i)
        float hi = array.get(tops, i)
        bool inside = low <= hi and high >= lo
        if inside and not array.get(touching, i)
            array.set(touches, i, array.get(touches, i) + 1)
        array.set(touching, i, inside)
        if (side == 1 ? close < lo : close > hi) or time - array.get(births, i) >= 28800000
            f_remove(i)
        else if side == 1 ? low > hi + a * 0.25 : high < lo - a * 0.25
            array.set(available, i, true)
        i -= 1
    // Cancel a pending setup immediately if its supporting zone was removed.
    bool stillExists = false
    if pending != 0 and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            if array.get(births, j) == zoneBirth and array.get(sides, j) == pending
                stillExists := true
    if pending != 0 and not stillExists
        pending := 0
        ended := true
        status := "Zone broken / removed"

    float span = high - low
    float cp = span > 0 ? (close - low) / span : 0.5
    bool eligible = pending == 0 and not ended and not na(a) and a > 0 and span >= a * 0.25 and span <= a * 1.5 and (na(lastSignal) or bar_index - lastSignal > cooldown) and inSession
    if not inSession and pending == 0 and not ended
        status := "Outside session hours"
    int chosen = -1
    float best = na
    bool conflict = false
    if eligible and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            int side = array.get(sides, j)
            float lo = array.get(bottoms, j)
            float hi = array.get(tops, j)
            // Previous close must approach from the correct side of the zone.
            bool rejection = side == 1 ? close[1] > hi and low <= hi and high >= lo and close > hi and close > open and cp >= 0.65 : close[1] < lo and high >= lo and low <= hi and close < lo and close < open and cp <= 0.35
            float trigger = side == 1 ? math.ceil((high + pad) / tick) * tick : math.floor((low - pad) / tick) * tick
            float stretch = side == 1 ? trigger - hi : lo - trigger
            float room = f_room(side, trigger)
            if rejection and array.get(available, j) and stretch <= a and (na(room) or room >= a * minRoom)
                if chosen >= 0 and array.get(sides, chosen) != side
                    conflict := true
                if na(best) or stretch < best
                    best := stretch
                    chosen := j
    if chosen >= 0 and not conflict
        pending := array.get(sides, chosen)
        zoneBirth := array.get(births, chosen)
        entry := pending == 1 ? math.ceil((high + pad) / tick) * tick : math.floor((low - pad) / tick) * tick
        invalid := pending == 1 ? math.min(low, array.get(bottoms, chosen)) - pad : math.max(high, array.get(tops, chosen)) + pad
        setupAtr := a
        armed := bar_index
        readySide := pending
        array.set(available, chosen, false)
        status := pending == 1 ? "READY BUY at support" : "READY SELL at resistance"

// Vivid palette: green = BUY zone, red = SELL zone, amber = weak zone (caution, no trade)
color green = #00E676
color red = #FF1744
color amber = #FFAB00
color blue = #2979FF
color panelBg = #131722
var array<box> boxes = array.new_box()
if barstate.islast
    for b in boxes
        box.delete(b)
    array.clear(boxes)
    if showZones and array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            int side = array.get(sides, j)
            int n = array.get(touches, j)
            bool brk = f_breakLean(side, n)
            color c = side == 1 ? green : red
            bool ob = array.get(kinds, j) == 1
            box b = box.new(left=array.get(births, j), top=array.get(tops, j), right=time + 60000, bottom=array.get(bottoms, j), xloc=xloc.bar_time, extend=extend.right, border_color=brk ? amber : c, border_width=brk ? 1 : 2, border_style=ob ? line.style_dashed : line.style_solid, bgcolor=color.new(brk ? amber : c, brk ? 90 : 82))
            array.push(boxes, b)

fastPlot = plot(fast, "EMA 20", color=#FFB300, linewidth=2)
slowPlot = plot(slow, "EMA 50", color=blue, linewidth=2)
fill(fastPlot, slowPlot, color=fast > slow ? color.new(green, 85) : color.new(red, 85), title="EMA band")
plot(pending != 0 ? entry : signalPrice, "Entry trigger", color=pending == 1 or signalSide == 1 ? green : red, linewidth=2, style=plot.style_linebr)
plotshape(readySide == 1, "Buy ready", shape.circle, location.belowbar, green, text="READY", textcolor=green, size=size.tiny)
plotshape(readySide == -1, "Sell ready", shape.circle, location.abovebar, red, text="READY", textcolor=red, size=size.tiny)
plotshape(signalSide == 1 and liveSignal, "Live BUY", shape.labelup, location.belowbar, green, text="BUY", textcolor=color.white)
plotshape(signalSide == -1 and liveSignal, "Live SELL", shape.labeldown, location.abovebar, red, text="SELL", textcolor=color.white)
plotshape(showHistory and signalSide == 1 and not liveSignal, "Historical buy candidate", shape.triangleup, location.belowbar, color.gray, text="H", size=size.tiny)
plotshape(showHistory and signalSide == -1 and not liveSignal, "Historical sell candidate", shape.triangledown, location.abovebar, color.gray, text="H", size=size.tiny)
// One line per side: nearest zone, distance, tests so far, and what to do about it.
f_plan(int j, bool isSupport) =>
    string msg = isSupport ? "Below: no support zone" : "Above: no resistance zone"
    bool brk = true
    if j >= 0
        float edge = isSupport ? array.get(tops, j) : array.get(bottoms, j)
        float dist = isSupport ? close - edge : edge - close
        int n = array.get(touches, j)
        brk := f_breakLean(isSupport ? 1 : -1, n)
        string action = brk ? "WEAK - no " + (isSupport ? "BUY" : "SELL") : (isSupport ? "BUY" : "SELL") + " on rejection"
        msg := (isSupport ? "Below: SUPPORT " : "Above: RESISTANCE ") + str.tostring(edge, format.mintick) + " | " + str.tostring(dist / a, "#.#") + " ATR | tested " + str.tostring(n) + "x | " + action
    [msg, brk]

var table panel = table.new(position.bottom_right, 1, 7, bgcolor=panelBg, frame_color=color.new(color.white, 60), frame_width=1, border_color=color.new(color.white, 88), border_width=1)
if barstate.islast
    bool against = (pending != 0 ? pending : signalSide) * structure < 0
    int sIdx = -1
    int rIdx = -1
    float sTop = na
    float rBot = na
    if array.size(sides) > 0
        for j = 0 to array.size(sides) - 1
            float t = array.get(tops, j)
            float bt = array.get(bottoms, j)
            if array.get(sides, j) == 1 and t <= close and (na(sTop) or t > sTop)
                sIdx := j
                sTop := t
            if array.get(sides, j) == -1 and bt >= close and (na(rBot) or bt < rBot)
                rIdx := j
                rBot := bt
    [belowText, belowBrk] = f_plan(sIdx, true)
    [aboveText, aboveBrk] = f_plan(rIdx, false)
    string regime = trendUp ? "TREND UP -> BUY zones only" : trendDown ? "TREND DOWN -> SELL zones only" : "RANGE -> both sides"
    color regimeColor = trendUp ? green : trendDown ? red : blue
    color pendingColor = pending == 1 ? green : pending == -1 ? red : color.white
    table.cell(panel, 0, 0, "GOLD SNIPER  |  M5 + OB zones  |  M1 entry", text_color=color.white, bgcolor=color.new(color.white, 85), text_size=size.small)
    table.cell(panel, 0, 1, pending == 0 ? "Waiting  |  active zones: " + str.tostring(array.size(sides)) : (pending == 1 ? "READY BUY above " : "READY SELL below ") + str.tostring(entry, format.mintick), text_color=pendingColor, bgcolor=pending == 0 ? panelBg : color.new(pendingColor, 80), text_size=size.normal)
    table.cell(panel, 0, 2, status, text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 3, regime + "  |  structure " + (structure == 1 ? "BULLISH" : structure == -1 ? "BEARISH" : "none") + (against ? "  |  AGAINST STRUCTURE" : ""), text_color=against ? amber : regimeColor, bgcolor=color.new(against ? amber : regimeColor, 85), text_size=size.small)
    table.cell(panel, 0, 4, belowText, text_color=belowBrk ? amber : green, text_size=size.small)
    table.cell(panel, 0, 5, aboveText, text_color=aboveBrk ? amber : red, text_size=size.small)
    table.cell(panel, 0, 6, "Gray H = estimate; live may differ after reload", text_color=color.new(color.white, 50), text_size=size.tiny)
