//@version=6
indicator("EMA/RSI/ATR Advisory (view only)", shorttitle = "EMA-RSI-ATR Advisory",
     overlay = true, max_labels_count = 1, max_lines_count = 3)

emaFastLen    = input.int(20, "EMA Fast Period", minval = 1)
emaSlowLen    = input.int(50, "EMA Slow Period", minval = 2)
rsiLen        = input.int(14, "RSI Period", minval = 1)
rsiOverbought = input.int(70, "RSI Overbought", minval = 51, maxval = 100)
rsiOversold   = input.int(30, "RSI Oversold", minval = 0, maxval = 49)
atrLen        = input.int(14, "ATR Period", minval = 1)
atrSlMult     = input.float(1.5, "ATR Stop-Loss Multiplier", minval = 0.1, step = 0.1)
atrTp1Mult    = input.float(1.5, "ATR Take-Profit 1 Multiplier", minval = 0.1, step = 0.1)
atrTp2Mult    = input.float(3.0, "ATR Take-Profit 2 Multiplier", minval = 0.1, step = 0.1)
useRsiFilter  = input.bool(true, "Require RSI confirmation")
htfMultiplier = input.int(4, "Higher-timeframe multiplier (x current chart)", minval = 2, maxval = 30)
useHtfFilter  = input.bool(true, "Require higher-timeframe trend agreement")
moveToBreakeven = input.bool(true, "Move Stop Loss to breakeven after TP1")
clearOnClose  = input.bool(true, "Clear marker immediately when a trade closes")
showFiltered  = input.bool(false, "Show raw crossovers a filter blocked (debug)")
showTable     = input.bool(true, "Show status table")

currentTfSeconds = timeframe.in_seconds(timeframe.period)
htfMinutesRaw    = currentTfSeconds * htfMultiplier / 60
htfTimeframe     = htfMinutesRaw >= 1440 ? str.tostring(int(math.round(htfMinutesRaw / 1440))) + "D" : str.tostring(int(math.max(1, math.round(htfMinutesRaw))))

emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrLen)

crossedUp   = ta.crossover(emaFast, emaSlow)
crossedDown = ta.crossunder(emaFast, emaSlow)

bullishRsiOk = rsiValue > 50 and rsiValue < rsiOverbought
bearishRsiOk = rsiValue < 50 and rsiValue > rsiOversold

htfEmaFast = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, emaFastLen), lookahead = barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, emaSlowLen), lookahead = barmerge.lookahead_off)
htfBullish = htfEmaFast > htfEmaSlow
htfBearish = htfEmaFast < htfEmaSlow

buySignal  = crossedUp   and (not useRsiFilter or bullishRsiOk) and (not useHtfFilter or htfBullish)
sellSignal = crossedDown and (not useRsiFilter or bearishRsiOk) and (not useHtfFilter or htfBearish)

plotshape(showFiltered and crossedUp and not buySignal, title = "Crossed up, filtered out",
     style = shape.triangleup, location = location.belowbar, color = color.new(color.gray, 40), size = size.tiny)
plotshape(showFiltered and crossedDown and not sellSignal, title = "Crossed down, filtered out",
     style = shape.triangledown, location = location.abovebar, color = color.new(color.gray, 40), size = size.tiny)

bgColor = na(emaSlow) or na(htfEmaSlow) ? na :
     (emaFast > emaSlow and htfBullish) ? color.new(color.green, 93) :
     (emaFast < emaSlow and htfBearish) ? color.new(color.red, 93) : na
bgcolor(bgColor, title = "Trend agreement background")

var string status      = "NONE"
var int    direction   = 0
var float  entryPrice  = na
var float  takeProfit1 = na
var float  takeProfit2 = na
var float  managedSL   = na
var bool   tp1Hit       = false
var bool   caution      = false
var label  adviceLabel = na
var line   slLine       = na
var line   tp1Line      = na
var line   tp2Line      = na

bool tp1HitEvent = false
bool slHitEvent  = false
bool tp2HitEvent = false

if buySignal or sellSignal
    bool isBuy = buySignal
    direction   := isBuy ? 1 : -1
    status      := "OPEN"
    entryPrice  := close
    managedSL   := isBuy ? close - atrValue * atrSlMult : close + atrValue * atrSlMult
    takeProfit1 := isBuy ? close + atrValue * atrTp1Mult : close - atrValue * atrTp1Mult
    takeProfit2 := isBuy ? close + atrValue * atrTp2Mult : close - atrValue * atrTp2Mult
    tp1Hit      := false
    caution     := false

    label.delete(adviceLabel)
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)

    adviceLabel := label.new(bar_index, isBuy ? low : high, isBuy ? "BUY" : "SELL",
         style = isBuy ? label.style_label_up : label.style_label_down,
         color = isBuy ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white, size = size.normal,
         yloc = isBuy ? yloc.belowbar : yloc.abovebar)
    slLine  := line.new(bar_index, managedSL, bar_index + 1, managedSL,
         extend = extend.right, color = color.new(color.red, 0), width = 2, style = line.style_dashed)
    tp1Line := line.new(bar_index, takeProfit1, bar_index + 1, takeProfit1,
         extend = extend.right, color = color.new(color.green, 0), width = 2, style = line.style_dashed)
    tp2Line := line.new(bar_index, takeProfit2, bar_index + 1, takeProfit2,
         extend = extend.right, color = color.new(color.green, 0), width = 2, style = line.style_dashed)

else if status == "OPEN" or status == "TP1_HIT"
    bool isBuy = direction == 1
    bool hitSL  = isBuy ? low <= managedSL : high >= managedSL
    bool hitTp2 = isBuy ? high >= takeProfit2 : low <= takeProfit2
    bool hitTp1 = not tp1Hit and (isBuy ? high >= takeProfit1 : low <= takeProfit1)
    bool reversed = status == "OPEN" and (isBuy ? crossedDown : crossedUp)

    if hitSL
        slHitEvent := true
        if clearOnClose
            status := "NONE"
            direction := 0
            entryPrice  := na
            managedSL   := na
            takeProfit1 := na
            takeProfit2 := na
            tp1Hit      := false
            label.delete(adviceLabel)
            line.delete(slLine)
            line.delete(tp1Line)
            line.delete(tp2Line)
            adviceLabel := na
            slLine      := na
            tp1Line     := na
            tp2Line     := na
        else
            status := "STOPPED"
            label.set_text(adviceLabel, (isBuy ? "BUY" : "SELL") + " — STOPPED")
            label.set_color(adviceLabel, color.new(color.gray, 0))
    else if hitTp2
        tp2HitEvent := true
        if clearOnClose
            status := "NONE"
            direction := 0
            entryPrice  := na
            managedSL   := na
            takeProfit1 := na
            takeProfit2 := na
            tp1Hit      := false
            label.delete(adviceLabel)
            line.delete(slLine)
            line.delete(tp1Line)
            line.delete(tp2Line)
            adviceLabel := na
            slLine      := na
            tp1Line     := na
            tp2Line     := na
        else
            status := "TARGET_HIT"
            label.set_text(adviceLabel, (isBuy ? "BUY" : "SELL") + " — TARGET HIT")
            label.set_color(adviceLabel, color.new(color.teal, 0))
    else if hitTp1
        tp1Hit := true
        status := "TP1_HIT"
        tp1HitEvent := true
        if moveToBreakeven
            managedSL := entryPrice
            line.set_y1(slLine, managedSL)
            line.set_y2(slLine, managedSL)
        label.set_text(adviceLabel, (isBuy ? "BUY" : "SELL") + " — TP1 HIT")
        label.set_color(adviceLabel, color.new(isBuy ? color.green : color.red, 0))
    else if reversed
        status := "NONE"
        direction := 0
        entryPrice  := na
        managedSL   := na
        takeProfit1 := na
        takeProfit2 := na
        tp1Hit      := false
        label.delete(adviceLabel)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        adviceLabel := na
        slLine      := na
        tp1Line     := na
        tp2Line     := na

    caution := (status == "OPEN" or status == "TP1_HIT") and (isBuy ? close < emaFast : close > emaFast)

plot(emaFast, "EMA Fast", color = color.new(color.blue, 0))
plot(emaSlow, "EMA Slow", color = color.new(color.orange, 0))

alertcondition(buySignal,   title = "Advisory BUY (entry)",  message = "BUY {{ticker}} @ {{close}}")
alertcondition(sellSignal,  title = "Advisory SELL (entry)", message = "SELL {{ticker}} @ {{close}}")
alertcondition(tp1HitEvent, title = "Advisory TP1 hit",      message = "TP1 hit on {{ticker}} @ {{close}} — move Stop Loss to breakeven")
alertcondition(tp2HitEvent, title = "Advisory target hit",   message = "Target hit on {{ticker}} @ {{close}}")
alertcondition(slHitEvent,  title = "Advisory stopped out",  message = "Stopped out on {{ticker}} @ {{close}}")

var table statusTable = table.new(position.top_right, 2, 13, border_width = 1, bgcolor = color.new(color.black, 70))
if showTable and barstate.islast
    directionText = direction == 1 ? "BUY" : direction == -1 ? "SELL" : "-"
    stateText  = status == "NONE" ? "NO_SIGNAL" : directionText + " (" + status + ")"
    stateColor = status == "STOPPED" ? color.gray : status == "TARGET_HIT" ? color.teal : direction == 1 ? color.lime : direction == -1 ? color.red : color.white
    biasText   = na(emaSlow) ? "warming up" : emaFast > emaSlow ? "EMA fast > slow" : "EMA fast < slow"
    biasColor  = na(emaSlow) ? color.gray : emaFast > emaSlow ? color.lime : color.red
    htfText    = na(htfEmaSlow) ? "warming up" : htfBullish ? "bullish (" + htfTimeframe + ")" : "bearish (" + htfTimeframe + ")"
    htfColor   = na(htfEmaSlow) ? color.gray : htfBullish ? color.lime : color.red
    tp1Text    = na(takeProfit1) ? "-" : str.tostring(takeProfit1, format.mintick) + (tp1Hit ? " (HIT)" : "")
    slText     = na(managedSL) ? "-" : str.tostring(managedSL, format.mintick) + (tp1Hit and moveToBreakeven ? " (breakeven)" : "")
    table.cell(statusTable, 0, 0, "Symbol", text_color = color.white)
    table.cell(statusTable, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white)
    table.cell(statusTable, 0, 1, "State", text_color = color.white, bgcolor = color.new(color.gray, 50))
    table.cell(statusTable, 1, 1, stateText, text_color = stateColor, bgcolor = color.new(color.gray, 50))
    table.cell(statusTable, 0, 2, "Caution", text_color = color.white)
    table.cell(statusTable, 1, 2, caution ? "YES — weakening" : "no", text_color = caution ? color.orange : color.white)
    table.cell(statusTable, 0, 3, "Bias", text_color = color.white)
    table.cell(statusTable, 1, 3, biasText, text_color = biasColor)
    table.cell(statusTable, 0, 4, "HTF trend", text_color = color.white)
    table.cell(statusTable, 1, 4, htfText, text_color = htfColor)
    table.cell(statusTable, 0, 5, "Entry", text_color = color.white)
    table.cell(statusTable, 1, 5, na(entryPrice) ? "-" : str.tostring(entryPrice, format.mintick), text_color = color.white)
    table.cell(statusTable, 0, 6, "Stop Loss", text_color = color.white)
    table.cell(statusTable, 1, 6, slText, text_color = color.white)
    table.cell(statusTable, 0, 7, "Take Profit 1", text_color = color.white)
    table.cell(statusTable, 1, 7, tp1Text, text_color = color.white)
    table.cell(statusTable, 0, 8, "Take Profit 2", text_color = color.white)
    table.cell(statusTable, 1, 8, na(takeProfit2) ? "-" : str.tostring(takeProfit2, format.mintick), text_color = color.white)
    table.cell(statusTable, 0, 9, "RSI", text_color = color.white)
    table.cell(statusTable, 1, 9, str.tostring(rsiValue, "#.##"), text_color = color.white)
    table.cell(statusTable, 0, 10, "ATR", text_color = color.white)
    table.cell(statusTable, 1, 10, str.tostring(atrValue, format.mintick), text_color = color.white)
    table.cell(statusTable, 0, 11, "Bars loaded", text_color = color.white)
    table.cell(statusTable, 1, 11, str.tostring(bar_index + 1), text_color = na(emaSlow) ? color.orange : color.white)
    table.cell(statusTable, 0, 12, "Auto HTF", text_color = color.white)
    table.cell(statusTable, 1, 12, htfTimeframe + " (x" + str.tostring(htfMultiplier) + ")", text_color = color.white)
