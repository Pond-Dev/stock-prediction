# Copy this file to .env or set the variables in the process environment.
# Never commit the populated .env file. Values below are intentionally empty.

# Telegram API credentials from https://my.telegram.org/apps
TGXM_TELEGRAM_API_ID=
TGXM_TELEGRAM_API_HASH=

# Telethon session path/name. The generated *.session* files are gitignored.
TGXM_TELEGRAM_SESSION=state/telegram/tgxm

# Optional comma-separated numeric Telegram IDs for future admin/alerts.
TGXM_TELEGRAM_ADMIN_IDS=
TGXM_TELEGRAM_ALERT_CHAT_ID=

# Mandatory exact allowlists before XM WebTrader Demo submission can be armed.
# The WebTrader password is entered manually in the dedicated browser profile;
# this bot neither reads it from this file nor stores it in configuration.
# Example format only: 12345678,87654321
TGXM_ALLOWED_DEMO_ACCOUNTS=
# Example format only: XMGlobal-MT5 2,XMGlobal-MT5 3
TGXM_ALLOWED_DEMO_SERVERS=
